+/// QA-only offline wrapper around the unchanged production friend-chat view.
+struct StoreScreenshotQualificationView: View {
+    @State private var chat: ChatSession?
+    @State private var path: [UUID] = []
+    @State private var failure = "Preparing local example"
+    private let peer = UUID(uuidString: "00000000-0000-4000-8000-000000000012")!
+    var body: some View {
+        NavigationStack(path: $path) {
+            Group {
+                if let chat {
+                    Text("Chats")
+                        .navigationDestination(for: UUID.self) { selectedPeer in
+                            FriendConversationView(chat: chat, peer: selectedPeer)
+                        }
+                        .onAppear { if path.isEmpty { path = [peer] } }
+                } else { Text(failure) }
+            }.navigationTitle("Chats")
+        }.task {
+            guard chat == nil else { return }
+            do {
+                let value = ChatSession(qualificationAPI: StoreScreenshotOfflineTransport(), userID: "store-screenshot-fictional")
+                let folder = FileManager.default.temporaryDirectory.appendingPathComponent("vipi-store-screenshot-" + UUID().uuidString)
+                try value.storeScreenshotSeed(directory: folder)
+                chat = value
+            } catch { failure = "Local example unavailable" }
+        }
+    }
+}
+private final class StoreScreenshotOfflineTransport: ChatTransport {
+    func request<T: Decodable>(_ method: String, _ path: String, body: Data?, device: DeviceCredential?, query: [String: String], as type: T.Type) async throws -> T {
+        let value: [String: Any]
+        if method == "GET", path.hasPrefix("/v1/blocks/") { value = ["blocked": false] }
+        else if method == "GET", path == "/v1/messages/pending" { value = ["messages": [], "next_cursor": NSNull()] }
+        else { throw ServiceFailure(status: 0, code: "screenshot_offline") }
+        return try JSONDecoder().decode(type, from: JSONSerialization.data(withJSONObject: value))
+    }
+}
 #endif
