  "definitions": {
    "in_scope": "An existing frozen OpenNLP NOUN/ADJ/ADV token whose full UTF16 range equals one retained native word. No new annotation or confidence threshold.",
    "projected_focus": "Any recorded structurally eligible projected candidate in this arm before actual-role/content/same-face/mask/known/selection filters.",
    "in_scope_projected_focus": "Such a projected focus exactly matches an in-scope native word.",
    "verb_only_proxy": "zero_scope_VERB_present plus zero_scope_AUX_only_of_verb_tags: at least one VERB/AUX and no in-scope NOUN/ADJ/ADV; other function/proper-name/unmapped words can still exist. This is not literally all words are verbs.",
    "zero_scope_no_VERB_or_AUX": "No exact native token in either role group; may include proper names, interjections, closed classes or tokenization/unassessed cases.",
    "first_loss": "Same ordered availability attribution as immutable r01, checked exactly for all four arm/state combinations; not recoverable correctness."
  },
  "limits": [
    "NOUN/ADJ/ADV tags indicate diagnostic scope, not verified vocabulary meanings or correct tags.",
    "An in-scope word without a projected focus may lack a source context, a retained relation, a complete supported form or a fitting witness; this crossing does not isolate those causes.",
    "VERB/AUX absence from current emission policy is intentional, but AUX is often grammar rather than vocabulary.",
    "No raw samples, proof copies, selector changes, guard relaxation or semantic claims."
  ],
  "interpretation": "The largest first-loss group predominantly contains words in the diagnostic POS scope; exclusion of entire utterances from that scope is not its main explanation. Missing projected support does not prove missing dictionary meanings or recoverable correct output."
