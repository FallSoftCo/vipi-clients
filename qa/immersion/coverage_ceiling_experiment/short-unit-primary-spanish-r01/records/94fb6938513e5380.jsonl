{"senses": [{"examples": [{"tags": ["collocation"], "text": "esperar con interés", "bold_text_offsets": [[0, 7]], "translation": "to look forward to, to eagerly await", "english": "to look forward to, to eagerly await", "type": "example"}, {"text": "En vano esperaron mejores días.", "bold_text_offsets": [[8, 17]], "translation": "They hoped for better days in vain.", "english": "They hoped for better days in vain.", "bold_translation_offsets": [[5, 14]], "type": "example"}, {"text": "Esperamos llegar a viejos juntos.", "bold_text_offsets": [[0, 9]], "translation": "We hope we'll grow old together.", "english": "We hope we'll grow old together.", "bold_translation_offsets": [[3, 7]], "type": "example"}, {"text": "Ella espera ya estar casada cuando tenga treinta.", "bold_text_offsets": [[5, 11]], "translation": "She hopes she'll be already married when she's 30 years old.", "english": "She hopes she'll be already married when she's 30 years old.", "bold_translation_offsets": [[4, 9]], "type": "example"}, {"text": "Espera que no sea necesario.", "bold_text_offsets": [[0, 6]], "translation": "He hopes it won't be necessary.", "english": "He hopes it won't be necessary.", "bold_translation_offsets": [[3, 8]], "type": "example"}], "info_templates": [{"args": {"1": "es", "2": "dirobj<for something>/inf<to do something>/:que(sub-cl)<that something happens>"}, "name": "+obj", "extra_data": {"words": ["direct", "object", "‘for", "something’", "infinitive", "‘to", "do", "something’", "que", "(+", "subjunctive", "clause)", "‘that", "something", "happens’"]}, "expansion": "[with direct object ‘for something’ or infinitive ‘to do something’ or que (+ subjunctive clause) ‘that something happens’]"}], "categories": ["Spanish terms with collocations", "Spanish terms with usage examples", "Spanish transitive verbs"], "links": [["hope", "hope"]], "synonyms": [{"word": "tener esperanza de que"}], "raw_glosses": ["(transitive or catenative) to hope [with direct object ‘for something’ or infinitive ‘to do something’ or que (+ subjunctive clause) ‘that something happens’]"], "glosses": ["to hope"], "tags": ["catenative", "transitive"]}, {"examples": [{"text": "Ellos esperan encontrar muchas dificultades.", "bold_text_offsets": [[6, 13]], "translation": "They expect to come across many hardships.", "english": "They expect to come across many hardships.", "bold_translation_offsets": [[5, 11]], "type": "example"}, {"text": "Esperamos un clima adverso mañana.", "bold_text_offsets": [[0, 9]], "translation": "We're expecting unfavourable weather tomorrow.", "english": "We're expecting unfavourable weather tomorrow.", "bold_translation_offsets": [[6, 15]], "type": "example"}, {"text": "Los estudiantes esperan que no será fácil el examen.", "bold_text_offsets": [[16, 23]], "translation": "The students expect the exam won't be easy.", "english": "The students expect the exam won't be easy.", "bold_translation_offsets": [[13, 19]], "type": "example"}, {"text": "Los huéspedes esperan que les ayudaremos.", "bold_text_offsets": [[14, 21]], "translation": "The guests expect we'll help them.", "english": "The guests expect we'll help them.", "bold_translation_offsets": [[11, 17]], "type": "example"}], "info_templates": [{"args": {"1": "es", "2": "dirobj<something>/inf<to do something>/:que(ind-cl)<that something happens>"}, "name": "+obj", "extra_data": {"words": ["direct", "object", "‘something’", "infinitive", "‘to", "do", "something’", "que", "(+", "indicative", "clause)", "‘that", "something", "happens’"]}, "expansion": "[with direct object ‘something’ or infinitive ‘to do something’ or que (+ indicative clause) ‘that something happens’]"}], "categories": ["Spanish terms with usage examples", "Spanish transitive verbs"], "links": [["expect", "expect"]], "synonyms": [{"word": "anticipar"}], "raw_glosses": ["(transitive or catenative) to expect [with direct object ‘something’ or infinitive ‘to do something’ or que (+ indicative clause) ‘that something happens’]"