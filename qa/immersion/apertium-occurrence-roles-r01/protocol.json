  "prior_rows_sha256": "4a29a50d0402d33ebd6d7b10ea05f7447975d21a375e1a3e2b3f05af52bd4a58",
  "versions": {
    "apertium": "3.9.4-1build1",
    "lttoolbox": "3.7.6-1build1",
    "apertium-eng-spa": "0.8.1-2"
  },
  "stages": [
    "apertium-destxt",
    "lt-proc DIRECTION.automorf.bin",
    "apertium-tagger -g -p DIRECTION.prob"
  ],
  "semantics": "FST morphology then pretrained HMM contextual disambiguation. -p preserves surface forms only. No CG stage in retained modes. No transfer/lexical selection/generation or translation used as role truth.",
  "limits": {
    "CPU": 1,
    "AS_bytes": 268435456,
    "seconds": 120,
    "output_bytes": 8388608,
    "additional_reservation_bytes": 33554432,
    "floor_bytes": 8589934592
  },
  "mapping_policy": "Parse escaped stream lexical units; match exact surfaces left-to-right against original text; map only original tokens exactly covered by one lexical unit. Multiword/split/contraction units and unknown or unmatched units remain explicit unassessable; do not hand-repair words. Retain raw morphology alternatives and chosen contextual reading.",
  "tag_to_UPOS": {
    "n": "NOUN",
    "np": "PROPN",
    "vblex": "VERB",
    "vaux": "AUX",
    "vbser": "AUX",
    "vbhaver": "AUX",
    "adj": "ADJ",
    "adv": "ADV",
    "det": "DET",
    "prn": "PRON",
    "pr": "ADP",
    "num": "NUM",
    "cnjcoo": "CCONJ",
    "cnjsub": "SCONJ",
    "ij": "INTJ"
  },
  "reference_reviews": {
    "author": "b3b5a9675e6610bf459515488c03ef733d630b06017a1064540ed89a033f55c1",
    "root": "a196b888aa1468e240fb65ad18c3fb3796cf834316e8e36a6e2df234a30da61d"
  },
  "sources": [
    "https://wiki.apertium.org/wiki/Part-of-speech_tagging",
    "https://wiki.apertium.org/wiki/Apertium_stream_format",
    "retained usr/share/man/man1/apertium-tagger.1.gz describes -g Viterbi and -p surface preservation"
  ],
  "no_new_training": true,
  "no_activation": true
}
