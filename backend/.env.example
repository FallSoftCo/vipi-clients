VIPI_DATABASE_URL=postgresql+asyncpg://vipi:CHANGE_ME@127.0.0.1:5432/vipi
VIPI_WORKOS_CLIENT_ID=client_REPLACE
VIPI_WORKOS_ISSUER=https://api.workos.com
VIPI_SERVICE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_BASE64URL
VIPI_ENVIRONMENT=development

# Enable after migrating the relay and provisioning its private media directory.
VIPI_MEDIA_ENABLED=false
# With the media service enabled, close new admissions and keep existing grants readable.
VIPI_MEDIA_DRAINING=false
VIPI_MEDIA_STORAGE_PATH=/var/lib/vipi-media
# Local development defaults. Set these against the provisioned shared volume.
VIPI_MEDIA_GLOBAL_BYTES=1073741824
VIPI_MEDIA_GLOBAL_BLOBS=8192
VIPI_MEDIA_MIN_FREE_BYTES=1073741824
VIPI_MEDIA_MIN_FREE_INODES=1024
# Staging and production require the UUID in the provisioned private volume's
# .vipi-volume-id file. The application never creates or replaces this marker.
# VIPI_MEDIA_VOLUME_ID=<provisioned UUID>
