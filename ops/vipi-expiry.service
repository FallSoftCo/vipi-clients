[Unit]
Description=Vipi expired ciphertext and metadata cleanup
After=postgresql.service

[Service]
Type=oneshot
User=vipi
Group=vipi
WorkingDirectory=/opt/vipi/current
EnvironmentFile=/etc/vipi/service.env
Environment=PYTHONPATH=/opt/vipi/current/deps
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m vipi.maintenance
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
MemoryMax=128M
TimeoutStartSec=45
