[Unit]
Description=Vipi private inbox notification delivery
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=vipi
Group=vipi
WorkingDirectory=/opt/vipi/current
EnvironmentFile=/etc/vipi/service.env
Environment=PYTHONPATH=/opt/vipi/current/deps
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m vipi.push
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
MemoryMax=192M
CPUQuota=100%
TasksMax=32

[Install]
WantedBy=multi-user.target
