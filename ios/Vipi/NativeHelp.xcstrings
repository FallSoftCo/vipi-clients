    "help_status_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One check means Vipi accepted the message. Two checks mean it reached your friend’s device. The checks change color when their app confirms the message was shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una marca indica que Vipi aceptó el mensaje. Dos indican que llegó al dispositivo de tu amigo. Cambian de color cuando su aplicación confirma que el mensaje se mostró."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Häkchen bedeutet, dass Vipi die Nachricht angenommen hat. Zwei bedeuten, dass sie auf dem Gerät deines Kontakts angekommen ist. Sie wechseln die Farbe, wenn dessen App die Anzeige bestätigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une coche signifie que Vipi a accepté le message. Deux coches indiquent qu’il est arrivé sur l’appareil de votre ami. Leur couleur change quand son application confirme l’affichage du message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una spunta indica che Vipi ha accettato il messaggio. Due indicano che è arrivato al dispositivo del tuo amico. Cambiano colore quando la sua app ne conferma la visualizzazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma marca indica que o Vipi aceitou a mensagem. Duas indicam que ela chegou ao aparelho do seu amigo. Elas mudam de cor quando o aplicativo do seu amigo confirma a exibição da mensagem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma marca indica que o Vipi aceitou a mensagem. Duas indicam que chegou ao dispositivo do seu amigo. Mudam de cor quando a aplicação do seu amigo confirma a apresentação da mensagem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma marca indica que o Vipi aceitou a mensagem. Duas indicam que chegou ao dispositivo do seu amigo. Mudam de cor quando a aplicação do seu amigo confirma a apresentação da mensagem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个勾表示 Vipi 已接受消息，两个勾表示已送达朋友的设备。对方的应用确认已显示消息后，勾的颜色会改变。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시 한 개는 Vipi가 메시지를 접수했다는 뜻이고, 두 개는 친구의 기기에 도착했다는 뜻입니다. 친구의 앱에서 메시지가 표시되었다고 확인하면 색이 바뀝니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個勾表示 Vipi 已受理訊息，兩個勾表示已送達朋友的裝置。對方的 App 確認已顯示訊息後，勾的顏色會改變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェック1つはVipiがメッセージを受け付けたこと、2つは相手の端末に届いたことを示します。相手のアプリが表示を確認すると色が変わります。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Alama moja inaonyesha Vipi imepokea ujumbe. Mbili zinaonyesha umefika kwenye kifaa cha rafiki yako. Rangi hubadilika programu yake inapothibitisha kuwa ujumbe ulionyeshwa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعني علامة واحدة أن Vipi قبل الرسالة. وتعني علامتان أنها وصلت إلى جهاز صديقك. يتغير اللون حين يؤكد تطبيقه عرض الرسالة."
          }
        }
      }
    },
    "help_status_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a message is missing, reconnect and reopen the conversation. Undelivered messages expire after 72 hours. Send a new message if it is still relevant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si falta un mensaje, vuelve a conectarte y abre la conversación. Los mensajes no entregados caducan a las 72 horas. Envía uno nuevo si sigue siendo relevante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlt eine Nachricht, stelle die Verbindung wieder her und öffne den Chat erneut. Nicht zugestellte Nachrichten verfallen nach 72 Stunden. Sende bei Bedarf eine neue Nachricht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’il manque un message, reconnectez-vous et rouvrez la discussion. Les messages non livrés expirent après 72 heures. Envoyez un nouveau message si nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se manca un messaggio, riconnettiti e riapri la conversazione. I messaggi non consegnati scadono dopo 72 ore. Se serve, inviane uno nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se faltar uma mensagem, reconecte e abra a conversa novamente. Mensagens não entregues expiram após 72 horas. Envie outra se ainda for relevante."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se faltar uma mensagem, volte a estabelecer ligação e reabra a conversa. As mensagens não entregues expiram após 72 horas. Envie uma nova se ainda fizer sentido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se faltar uma mensagem, volte a estabelecer ligação e reabra a conversa. As mensagens não entregues expiram após 72 horas. Envie uma nova se ainda fizer sentido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果找不到消息，请重新连接并打开对话。未送达的消息会在 72 小时后过期。如果仍有需要，请发送一条新消息。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지가 보이지 않으면 다시 연결하고 대화를 다시 여세요. 전달되지 않은 메시지는 72시간 후 만료됩니다. 여전히 필요하면 새 메시지를 보내세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果找不到訊息，請重新連線並開啟對話。未送達的訊息會在 72 小時後過期。如果仍有需要，請傳送新訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージが見当たらないときは、接続し直して会話を開き直します。未配信メッセージは72時間で期限切れになります。必要なら新しいメッセージを送ってください。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujumbe ukikosekana, unganisha tena na ufungue mazungumzo. Ujumbe ambao haujawasilishwa huisha baada ya saa 72. Tuma ujumbe mpya ikiwa bado unahitajika."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كانت هناك رسالة مفقودة، أعد الاتصال وافتح المحادثة مجددًا. تنتهي صلاحية الرسائل غير المسلّمة بعد 72 ساعة. أرسل رسالة جديدة إذا بقيت ذات صلة."
          }
        }
      }
    },
    "help_account_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect or change phones"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a conectarte o cambiar de teléfono"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut anmelden oder das Telefon wechseln"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reconnecter ou changer de téléphone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricollegarsi o cambiare telefono"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconectar ou trocar de celular"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar a entrar ou mudar de telemóvel"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar a entrar ou mudar de telemóvel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新连接或更换手机"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 연결하거나 휴대전화 변경"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新連線或更換手機"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再ログイン・機種変更"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unganisha tena au badili simu"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة الاتصال أو تغيير الهاتف"
          }
        }
      }
    },
    "help_account_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Vipi asks you to sign in again, use the same account. Your saved chats stay on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Vipi te pide iniciar sesión de nuevo, utiliza la misma cuenta. Los chats guardados permanecen en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Vipi dich zur erneuten Anmeldung auffordert, verwende dasselbe Konto. Gespeicherte Chats bleiben auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Vipi vous demande de vous reconnecter, utilisez le même compte. Les discussions enregistrées restent sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se Vipi chiede di accedere di nuovo, usa lo stesso account. Le chat salvate rimangono su questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o Vipi pedir um novo login, use a mesma conta. As conversas salvas ficam neste aparelho."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o Vipi pedir para iniciar sessão novamente, use a mesma conta. As conversas guardadas ficam neste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o Vipi pedir para iniciar sessão novamente, use a mesma conta. As conversas guardadas ficam neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Vipi 要求重新登录，请使用同一账户。已保存的聊天仍在本设备上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vipi에서 다시 로그인을 요청하면 같은 계정을 사용하세요. 저장된 대화는 이 기기에 남습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Vipi 要求重新登入，請使用同一帳號。已儲存的聊天仍在這部裝置上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインを求められたら、同じアカウントを使います。保存済みのチャットはこの端末に残ります。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikiwa Vipi inakuomba uingie tena, tumia akaunti ileile. Gumzo zilizohifadhiwa hubaki kwenye kifaa hiki."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا طلب Vipi تسجيل الدخول مجددًا، فاستخدم الحساب نفسه. تبقى الدردشات المحفوظة على هذا الجهاز."
          }
        }
      }
    },
    "help_account_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choosing Use this device activates the new phone and disconnects the previous one. Pending deliveries cannot move to the new device. Compare the new security number with your friends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar este dispositivo activa el teléfono nuevo y desconecta el anterior. Las entregas pendientes no se transfieren. Compara el nuevo número de seguridad con tus amigos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Dieses Gerät verwenden“ aktiviert das neue Telefon und trennt das vorherige. Ausstehende Nachrichten lassen sich nicht übertragen. Vergleiche die neue Sicherheitsnummer mit deinen Freunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser cet appareil active le nouveau téléphone et déconnecte l’ancien. Les envois en attente ne sont pas transférés. Comparez le nouveau numéro de sécurité avec vos amis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa questo dispositivo attiva il nuovo telefono e scollega il precedente. Le consegne in sospeso non vengono trasferite. Confronta il nuovo numero di sicurezza con i tuoi amici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar este dispositivo ativa o novo celular e desconecta o anterior. As entregas pendentes não são transferidas. Compare o novo número de segurança com seus amigos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar este dispositivo ativa o novo telemóvel e desliga o anterior. As entregas pendentes não passam para o novo dispositivo. Compare o novo número de segurança com os seus amigos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar este dispositivo ativa o novo telemóvel e desliga o anterior. As entregas pendentes não passam para o novo dispositivo. Compare o novo número de segurança com os seus amigos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“使用此设备”会激活新手机，并断开旧设备。等待送达的消息无法转移。请和朋友核对新的安全号码。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기 사용을 선택하면 새 휴대전화가 활성화되고 이전 기기의 연결은 끊깁니다. 전달 대기 중인 메시지는 옮길 수 없습니다. 친구와 새 보안 번호를 비교하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「使用這部裝置」會啟用新手機並中斷舊裝置的連線。等待送達的訊息無法轉移。請與朋友核對新的安全號碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「この端末を使用」を選ぶと新しい端末が有効になり、以前の端末は切断されます。配信待ちのメッセージは移行できません。新しいセキュリティ番号を友達と照合してください。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukichagua Tumia kifaa hiki, simu mpya itaanza kutumika na ya awali itatenganishwa. Ujumbe unaosubiri kuwasilishwa hauhamishwi. Linganisha namba mpya ya usalama na marafiki zako."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي اختيار استخدام هذا الجهاز إلى تفعيل الهاتف الجديد وفصل الهاتف السابق. لا يمكن نقل الرسائل التي تنتظر التسليم. قارن رقم الأمان الجديد مع أصدقائك."
          }
        }
      }
    },
