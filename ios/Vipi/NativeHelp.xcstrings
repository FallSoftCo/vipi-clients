    "help_friends_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find and invite friends"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar e invitar a tus amigos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freunde finden und einladen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouver et inviter des amis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trovare e invitare amici"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrar e convidar amigos"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrar e convidar amigos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrar e convidar amigos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找并邀请朋友"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구 찾기 및 초대"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找並邀請朋友"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達を探す・招待する"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tafuta na ualike marafiki"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العثور على الأصدقاء ودعوتهم"
          }
        }
      }
    },
    "help_friends_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Chats and start a new conversation. Choose a saved friend or enter their exact Vipi username."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Chats, inicia una conversación. Elige un amigo guardado o introduce su nombre de usuario exacto de Vipi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne unter Chats eine Unterhaltung. Wähle einen gespeicherten Kontakt oder gib dessen genauen Vipi-Benutzernamen ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Discussions, lancez une conversation. Choisissez un ami enregistré ou saisissez son nom d’utilisateur Vipi exact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Chat avvia una conversazione. Scegli un amico salvato o inserisci il suo nome utente Vipi esatto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Conversas, inicie uma conversa. Escolha um amigo salvo ou digite o nome de usuário exato da pessoa no Vipi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Conversas, inicie uma conversa. Escolha um amigo ou introduza o nome de utilizador exato dessa pessoa no Vipi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Conversas, inicie uma conversa. Escolha um amigo ou introduza o nome de utilizador exato dessa pessoa no Vipi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在聊天中发起新对话。选择已保存的朋友，或输入对方完整、准确的 Vipi 用户名。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅에서 새 대화를 시작하세요. 저장된 친구를 선택하거나 친구의 정확한 Vipi 사용자 이름을 입력하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在聊天中開始新對話。選擇已儲存的朋友，或輸入對方完整、正確的 Vipi 使用者名稱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットから新しい会話を始めます。登録済みの友達を選ぶか、相手のVipiユーザー名を正確に入力します。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Katika Gumzo, anza mazungumzo mapya. Chagua rafiki uliyemhifadhi au andika jina lake la mtumiaji wa Vipi kwa usahihi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ محادثة جديدة من قائمة الدردشات. اختر صديقًا محفوظًا أو أدخل اسم مستخدم Vipi الخاص به بدقة."
          }
        }
      }
    },
    "help_friends_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To invite someone who hasn’t joined, choose Invite a friend. Review the invitation before sending it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para invitar a alguien que aún no usa Vipi, elige Invitar a un amigo. Revisa la invitación antes de enviarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze „Freund einladen“, wenn jemand Vipi noch nicht verwendet. Prüfe die Einladung vor dem Senden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour inviter une personne qui n’utilise pas encore Vipi, choisissez Inviter un ami. Relisez l’invitation avant de l’envoyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per invitare chi non usa ancora Vipi, scegli Invita un amico. Rileggi l’invito prima di inviarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para convidar alguém que ainda não usa o Vipi, escolha Convidar um amigo. Revise o convite antes de enviar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para convidar alguém que ainda não usa o Vipi, escolha Convidar um amigo. Reveja o convite antes de o enviar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para convidar alguém que ainda não usa o Vipi, escolha Convidar um amigo. Reveja o convite antes de o enviar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果对方还没有使用 Vipi，请选择“邀请朋友”，检查邀请内容后再发送。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 Vipi를 사용하지 않는 사람은 친구 초대로 초대할 수 있습니다. 보내기 전에 초대 내용을 확인하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果對方還沒使用 Vipi，請選擇「邀請朋友」，檢查邀請內容後再傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだVipiを使っていない人には「友達を招待」を選び、内容を確認してから招待を送ります。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtu ambaye bado hatumii Vipi anaweza kualikwa kupitia Alika rafiki. Soma mwaliko kabla ya kuutuma."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لدعوة شخص لم ينضم بعد، اختر دعوة صديق. راجع الدعوة قبل إرسالها."
          }
        }
      }
    },
    "help_languages_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a practice language"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir un idioma de práctica"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Übungssprache wählen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une langue à pratiquer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegliere una lingua da praticare"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher um idioma para praticar"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher um idioma para praticar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher um idioma para praticar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择练习语言"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습할 언어 선택"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇練習語言"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習する言語を選ぶ"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua lugha ya kufanya mazoezi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار لغة للتدرّب"
          }
        }
      }
    },
    "help_languages_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the language at the top of Chats. Choose the language you want to practice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el idioma que aparece arriba en Chats y elige el que quieras practicar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben in Chats auf die Sprache und wähle die Sprache, die du üben möchtest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la langue en haut des discussions et choisissez celle que vous souhaitez pratiquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la lingua in alto in Chat e scegli quella che vuoi esercitare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no idioma no topo de Conversas e escolha qual você quer praticar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no idioma no topo de Conversas e escolha o que pretende praticar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no idioma no topo de Conversas e escolha o que pretende praticar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点聊天顶部的语言，选择想练习的语言。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 상단의 언어를 눌러 연습할 언어를 선택하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下聊天頂端的語言，選擇想練習的語言。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットの上部にある言語をタップして、練習したい言語を選びます。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa lugha iliyo juu ya orodha ya gumzo kisha uchague lugha unayotaka kufanyia mazoezi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على اللغة أعلى قائمة الدردشات واختر اللغة التي تريد التدرّب عليها."
          }
        }
      }
    },
    "help_languages_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Languages in Settings to manage the downloads for your language pair. Tap a practice message to hear it when a voice is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes, abre Idiomas para gestionar las descargas. Toca un mensaje de práctica para escucharlo si hay una voz disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Einstellungen → Sprachen verwaltest du die Downloads. Tippe auf eine Übungsnachricht, um sie anzuhören, wenn eine Stimme verfügbar ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages, ouvrez Langues pour gérer les téléchargements. Touchez un message pour l’écouter si une voix est disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Impostazioni apri Lingue per gestire i download. Tocca un messaggio per ascoltarlo quando è disponibile una voce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas Configurações, abra Idiomas para gerenciar os downloads. Toque em uma mensagem para ouvi-la quando houver uma voz disponível."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas Definições, abra Idiomas para gerir os ficheiros de idioma. Toque numa mensagem para a ouvir quando houver uma voz disponível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas Definições, abra Idiomas para gerir os ficheiros de idioma. Toque numa mensagem para a ouvir quando houver uma voz disponível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中打开语言选项，管理所需的语言下载。语音可用时，轻点练习消息即可收听。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정의 언어에서 필요한 언어 파일을 관리하세요. 음성을 사용할 수 있으면 연습 메시지를 눌러 들을 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中打開語言選項，管理需要下載的語言。語音可用時，點一下練習訊息即可聆聽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の「言語」で必要なデータを管理できます。音声が利用できる場合、練習メッセージをタップすると読み上げます。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua Lugha katika Mipangilio ili kudhibiti vipakuliwa. Gusa ujumbe wa mazoezi ili kuusikiliza ikiwa sauti inapatikana."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح اللغات في الإعدادات لإدارة التنزيلات. اضغط على رسالة التدريب للاستماع إليها عند توفر صوت."
          }
        }
      }
    },
    "help_notifications_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep previews private"
          }
