    "help_voice_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a friend’s chat, hold the microphone to record. Release to send. While holding, slide toward Cancel to discard, or slide up to lock recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un chat con un amigo, mantén pulsado el micrófono para grabar. Suelta para enviar. Sin levantar el dedo, desliza hacia Cancelar para descartar o hacia arriba para fijar la grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans une discussion, maintenez le micro pour enregistrer. Relâchez pour envoyer. Sans lever le doigt, glissez vers Annuler pour effacer ou vers le haut pour verrouiller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte in einem Chat mit einem Freund das Mikrofon gedrückt. Lass los, um zu senden. Wische beim Halten in Richtung Abbrechen, um die Aufnahme zu verwerfen, oder nach oben, um sie zu fixieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella chat con un amico, tieni premuto il microfono per registrare. Rilascia per inviare. Senza alzare il dito, scorri verso Annulla per scartare o verso l’alto per bloccare la registrazione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Numa conversa com um amigo, mantenha o microfone premido para gravar. Solte para enviar. Sem levantar o dedo, deslize para Cancelar para descartar ou para cima para fixar a gravação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na conversa com um amigo, toque e segure o microfone para gravar. Solte para enviar. Sem tirar o dedo, deslize em direção a Cancelar para descartar ou para cima para travar a gravação."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Katika gumzo na rafiki, bonyeza na ushikilie maikrofoni ili kurekodi. Achia ili kutuma. Ukiwa bado umeshikilia, telezesha kuelekea Ghairi ili kufuta, au juu ili kuendelea kurekodi bila kushikilia."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في محادثة مع صديق، اضغط مطولًا على الميكروفون للتسجيل وارفع إصبعك للإرسال. أثناء الضغط، اسحب باتجاه إلغاء لتجاهل التسجيل أو إلى الأعلى لتثبيت التسجيل."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達とのチャットでマイクを長押しして録音し、指を離すと送信します。押したままキャンセルの方向にスライドすると破棄、上にスライドすると録音を固定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구와의 채팅에서 마이크를 길게 눌러 녹음하고 손을 떼면 전송합니다. 누른 채로 취소 쪽으로 밀면 삭제되고 위로 밀면 녹음이 고정됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在与朋友的聊天中，按住麦克风录音，松开发送。按住时向取消提示滑动可丢弃录音，向上滑动可锁定录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在與朋友的聊天中，按住麥克風錄音，放開即可傳送。按住時朝取消提示滑動可捨棄錄音，向上滑動可鎖定錄音。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Numa conversa com um amigo, mantenha o microfone premido para gravar. Solte para enviar. Sem levantar o dedo, deslize para Cancelar para descartar ou para cima para fixar a gravação."
          }
        }
      }
    },
    "help_voice_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When recording is locked, tap Send to send it now or Stop to listen first. Tap the trash can to discard it. In the chat, tap a voice message to play or pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la grabación fijada, toca Enviar para mandarla en el momento o Detener para escucharla primero. Toca la papelera para descartarla. En el chat, toca un mensaje de voz para reproducirlo o pausarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois l’enregistrement verrouillé, touchez Envoyer pour l’envoyer immédiatement ou Arrêter pour l’écouter d’abord. Touchez la corbeille pour l’effacer. Dans la discussion, touchez un message vocal pour le lire ou le mettre en pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Aufnahme fixiert ist, tippe auf Senden, um sie sofort zu senden, oder auf Stopp, um sie zuerst anzuhören. Mit dem Papierkorb verwirfst du sie. Tippe im Chat auf eine Sprachnachricht, um sie abzuspielen oder zu pausieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la registrazione è bloccata, tocca Invia per inviarla subito oppure Stop per ascoltarla prima. Tocca il cestino per scartarla. Nella chat, tocca un messaggio vocale per riprodurlo o metterlo in pausa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a gravação fixa, toque em Enviar para a enviar já ou em Parar para a ouvir primeiro. Toque no caixote do lixo para a descartar. Na conversa, toque numa mensagem de voz para a reproduzir ou colocar em pausa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a gravação travada, toque em Enviar para enviá-la na hora ou em Parar para ouvir primeiro. Toque na lixeira para descartar. Na conversa, toque em uma mensagem de voz para ouvir ou pausar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unaporekodi bila kushikilia, gusa Tuma ili kutuma mara moja au Simamisha ili usikilize kwanza. Gusa aikoni ya pipa la taka ili kufuta. Katika gumzo, gusa ujumbe wa sauti ili uusikilize au uusitishe."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد تثبيت التسجيل، اضغط على إرسال لإرساله فورًا، أو على إيقاف للاستماع إليه أولًا. اضغط على سلة المهملات لتجاهله. في المحادثة، اضغط على الرسالة الصوتية لتشغيلها أو إيقافها مؤقتًا."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を固定したら、送信をタップするとすぐに送れます。先に聴くには停止を、破棄するにはゴミ箱をタップします。チャットのボイスメッセージをタップすると再生または一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 고정된 상태에서 전송을 누르면 바로 보내고, 정지를 누르면 먼저 들어볼 수 있습니다. 삭제하려면 휴지통을 누르세요. 채팅에서 음성 메시지를 누르면 재생하거나 일시 정지할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定录音后，轻点发送即可立即发出，或轻点停止先试听。轻点垃圾桶可丢弃录音。在聊天中轻点语音消息即可播放或暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定錄音後，點一下傳送即可立即送出，或點一下停止先試聽。點一下垃圾桶即可捨棄錄音。在對話中點一下語音訊息即可播放或暫停。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a gravação fixa, toque em Enviar para a enviar já ou em Parar para a ouvir primeiro. Toque no caixote do lixo para a descartar. Na conversa, toque numa mensagem de voz para a reproduzir ou colocar em pausa."
          }
        }
      }
    },
