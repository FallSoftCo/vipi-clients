{
  "sourceLanguage": "en",
  "strings": {
    "help_guide_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Shallow and Deep on a sample message. Hold to see what your friend wrote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba los dos modos de inmersión con un mensaje de ejemplo. Mantén pulsado para ver el original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere beide Immersionsmodi mit einer Beispielnachricht aus. Halte sie gedrückt, um das Original zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez les deux modes d’immersion sur un message. Maintenez le doigt dessus pour voir le texte original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova le due modalità di immersione con un messaggio di esempio. Tieni premuto per leggere l’originale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente os dois modos de imersão em uma mensagem de exemplo. Toque e segure para ver o original."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente os dois modos de imersão numa mensagem de exemplo. Mantenha o dedo na mensagem para ver o original."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente os dois modos de imersão numa mensagem de exemplo. Mantenha o dedo na mensagem para ver o original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用一条示例消息试试两种沉浸模式。按住即可查看朋友写的原文。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예시 메시지로 두 가지 몰입 모드를 체험해 보세요. 길게 누르면 친구가 쓴 원문을 볼 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用一則範例訊息試試兩種沉浸模式。按住即可查看朋友寫的原文。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例文で2つの没入モードを試せます。長押しすると相手が書いた原文が表示されます。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaribu aina zote mbili za mazoezi kwa kutumia ujumbe wa mfano. Bonyeza na ushikilie ili kuona ujumbe asilia wa rafiki yako."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب نمطَي الانغماس باستخدام رسالة نموذجية. اضغط مطولًا لرؤية النص الذي كتبه صديقك."
          }
        }
      }
    },
