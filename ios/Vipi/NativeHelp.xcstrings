    "help_notifications_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Notifications in Settings. Turn off Show sender and message to keep the contents of alerts private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes, abre Notificaciones y desactiva la opción de mostrar el remitente y el mensaje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Benachrichtigungen in den Einstellungen und schalte die Anzeige von Absender und Nachricht aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages, ouvrez Notifications et désactivez l’affichage de l’expéditeur et du message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Impostazioni apri Notifiche e disattiva la visualizzazione del mittente e del messaggio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas Configurações, abra Notificações e desative a exibição do remetente e da mensagem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas Definições, abra Notificações e desative a apresentação do remetente e da mensagem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas Definições, abra Notificações e desative a apresentação do remetente e da mensagem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中打开通知，关闭显示发件人和消息的选项。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 알림을 열고 발신자와 메시지 표시를 끄세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中打開通知，關閉顯示傳送者和訊息的選項。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の「通知」で、送信者とメッセージの表示をオフにします。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua Arifa katika Mipangilio na uzime chaguo la kuonyesha mtumaji na ujumbe."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الإشعارات في الإعدادات وأوقف عرض المرسل والرسالة."
          }
        }
      }
    },
    "help_notifications_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the example and your phone’s lock-screen settings. On iPhone, in-app previews have their own switch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el ejemplo y los ajustes de la pantalla de bloqueo del teléfono. En el iPhone, las vistas previas dentro de Vipi tienen un control independiente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe das Beispiel und die Einstellungen für den Sperrbildschirm. Auf dem iPhone haben Vorschauen innerhalb von Vipi einen eigenen Schalter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez l’exemple et les réglages de l’écran verrouillé. Sur iPhone, les aperçus à l’intérieur de Vipi ont leur propre réglage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla l’esempio e le impostazioni della schermata di blocco. Su iPhone le anteprime dentro Vipi hanno un controllo separato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o exemplo e as configurações da tela de bloqueio. No iPhone, as prévias dentro do Vipi têm um controle separado."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o exemplo e as definições do ecrã bloqueado. No iPhone, as pré-visualizações dentro do Vipi têm um controlo próprio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o exemplo e as definições do ecrã bloqueado. No iPhone, as pré-visualizações dentro do Vipi têm um controlo próprio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查显示示例和手机的锁屏设置。在 iPhone 上，Vipi 内的预览有单独的开关。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시 예시와 휴대전화의 잠금 화면 설정을 확인하세요. iPhone에서는 Vipi를 열어 둔 동안의 미리보기를 따로 설정할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看顯示範例與手機的鎖定畫面設定。在 iPhone 上，Vipi 內的預覽有獨立的開關。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示例と端末のロック画面の設定を確認してください。iPhoneでは、Vipiを開いている間のプレビューを別に設定できます。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Angalia mfano na mipangilio ya skrini iliyofungwa ya simu yako. Kwenye iPhone, hakikisho ndani ya Vipi lina swichi yake."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع المثال وإعدادات شاشة القفل في هاتفك. على iPhone يوجد خيار مستقل للمعاينات داخل Vipi."
          }
        }
      }
    },
    "help_safety_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
