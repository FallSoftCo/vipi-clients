    "help_groups_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open New chat and choose New group. Give the group a name and select the friends you want to invite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Nuevo chat y elige Nuevo grupo. Ponle un nombre y selecciona los amigos a los que quieras invitar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Neuer Chat und dann Neue Gruppe. Gib der Gruppe einen Namen und wähle die Freunde aus, die du einladen möchtest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Nouvelle discussion puis Nouveau groupe. Nommez le groupe et sélectionnez les amis à inviter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Nuova chat e poi Nuovo gruppo. Dai un nome al gruppo e seleziona gli amici da invitare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Nova conversa e escolha Novo grupo. Dê um nome ao grupo e selecione os amigos que quer convidar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Nova conversa e escolha Novo grupo. Dê um nome ao grupo e selecione os amigos a convidar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Nova conversa e escolha Novo grupo. Dê um nome ao grupo e selecione os amigos a convidar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新建聊天中选择新建群组。输入群名，选择要邀请的朋友。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 채팅에서 새 그룹을 선택하세요. 그룹 이름을 정하고 초대할 친구를 선택하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在新聊天中選擇新增群組。輸入群組名稱，選擇要邀請的朋友。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいチャットから「新しいグループ」を選びます。グループ名を入力し、招待する友達を選びます。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua gumzo jipya na uchague kikundi kipya. Kipe kikundi jina na uchague marafiki unaotaka kuwaalika."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح محادثة جديدة واختر مجموعة جديدة. أعطِ المجموعة اسمًا وحدّد الأصدقاء الذين تريد دعوتهم."
          }
        }
      }
    },
    "help_groups_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review your selection before sending invitations. Open Groups and invitations to see requests and choose which groups to join."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la selección antes de invitar. En Grupos e invitaciones puedes ver las solicitudes y elegir a qué grupos unirte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Auswahl vor dem Einladen. Unter Gruppen und Einladungen kannst du Anfragen ansehen und Gruppen beitreten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la sélection avant d’envoyer les invitations. Dans Groupes et invitations, consultez les demandes et choisissez les groupes à rejoindre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la selezione prima di invitare. In Gruppi e inviti trovi le richieste e puoi scegliere a quali gruppi unirti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira a seleção antes de enviar os convites. Em Grupos e convites, veja as solicitações e escolha de quais grupos participar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveja a seleção antes de enviar os convites. Em Grupos e convites, veja os pedidos e escolha os grupos a que pretende aderir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveja a seleção antes de enviar os convites. Em Grupos e convites, veja os pedidos e escolha os grupos a que pretende aderir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送邀请前请核对名单。在“群组和邀请”中查看请求，选择要加入的群组。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대하기 전에 명단을 확인하세요. 그룹 및 초대에서 요청을 보고 참여할 그룹을 고를 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送邀請前請核對名單。在「群組與邀請」中查看邀請，選擇要加入的群組。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ相手を確認してから招待を送ります。「グループと招待」で届いた招待を見て、参加するか選べます。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakiki orodha kabla ya kutuma mialiko. Katika Vikundi na mialiko unaweza kuona maombi na kuchagua vikundi vya kujiunga navyo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع الأسماء قبل إرسال الدعوات. افتح المجموعات والدعوات للاطلاع على الطلبات واختيار المجموعات التي تريد الانضمام إليها."
          }
        }
      }
    },
    "help_reading_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen and change the script"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchar y cambiar de escritura"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhören und die Schrift wechseln"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écouter et changer d’écriture"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascoltare e cambiare scrittura"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvir e mudar a escrita"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvir e mudar de escrita"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvir e mudar de escrita"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收听和切换文字"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듣기 및 문자 전환"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聆聽及切換文字"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げと文字の切り替え"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikiliza na ubadili mfumo wa maandishi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستماع وتبديل طريقة الكتابة"
          }
        }
      }
    },
    "help_reading_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a practice message to hear it. Double-tap to switch between the native script and its reading when both are available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un mensaje de práctica para escucharlo. Tócalo dos veces para alternar entre la escritura original y su lectura cuando ambas estén disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Übungsnachricht, um sie anzuhören. Tippe zweimal, um zwischen der ursprünglichen Schrift und der Lesehilfe zu wechseln, sofern beide verfügbar sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un message pour l’écouter. Touchez-le deux fois pour alterner entre l’écriture d’origine et sa transcription lorsque les deux sont disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un messaggio per ascoltarlo. Toccalo due volte per passare dalla scrittura originale alla trascrizione quando entrambe sono disponibili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma mensagem para ouvi-la. Toque duas vezes para alternar entre a escrita original e sua leitura quando ambas estiverem disponíveis."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque numa mensagem para a ouvir. Toque duas vezes para alternar entre a escrita original e a sua leitura quando ambas estiverem disponíveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque numa mensagem para a ouvir. Toque duas vezes para alternar entre a escrita original e a sua leitura quando ambas estiverem disponíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点练习消息即可收听。如果同时提供原文字形和读音，轻点两次可以切换显示方式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연습 메시지를 누르면 읽어 줍니다. 두 번 누르면 원래 문자와 읽는 방법 사이를 전환할 수 있습니다. 두 가지가 모두 제공되는 경우에만 가능합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下練習訊息即可聆聽。同時提供原文文字與讀音時，點兩下即可切換顯示方式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "練習メッセージをタップすると読み上げます。原文の文字と読み方の両方がある場合は、ダブルタップで表示を切り替えられます。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa ujumbe wa mazoezi ili kuusikiliza. Gusa mara mbili ili kubadili kati ya maandishi asilia na namna ya kuyasoma ikiwa zote zinapatikana."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على رسالة التدريب لسماعها. اضغط مرتين للتبديل بين الكتابة الأصلية وطريقة قراءتها عند توفرهما."
          }
        }
      }
    },
    "help_reading_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In conversation options, turn autoplay on to hear new messages. It stops when you leave the conversation. If a voice or language is missing, follow the download prompt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la reproducción automática en las opciones de la conversación para oír los mensajes nuevos. Se detiene al salir. Si falta una voz o un idioma, sigue las indicaciones de descarga."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere die automatische Wiedergabe in den Chatoptionen, um neue Nachrichten zu hören. Sie endet beim Verlassen des Chats. Fehlt eine Stimme oder Sprache, folge dem Downloadhinweis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la lecture automatique dans les options pour entendre les nouveaux messages. Elle s’arrête lorsque vous quittez la conversation. Si une voix ou une langue manque, suivez les indications de téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva la riproduzione automatica nelle opzioni della chat per ascoltare i nuovi messaggi. Si interrompe quando esci. Se manca una voce o una lingua, segui le indicazioni per il download."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a reprodução automática nas opções para ouvir as novas mensagens. Ela para quando você sai da conversa. Se faltar uma voz ou um idioma, siga as instruções de download."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a reprodução automática nas opções para ouvir as novas mensagens. A reprodução para ao sair da conversa. Se faltar uma voz ou um idioma, siga as instruções de transferência."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a reprodução automática nas opções para ouvir as novas mensagens. A reprodução para ao sair da conversa. Se faltar uma voz ou um idioma, siga as instruções de transferência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在对话选项中开启自动播放，即可收听新消息。离开对话后会停止播放。如果缺少语音或语言，请按提示下载。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 옵션에서 자동 재생을 켜면 새 메시지를 읽어 줍니다. 대화를 나가면 멈춥니다. 음성이나 언어가 없으면 다운로드 안내를 따르세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在對話選項中開啟自動播放，即可聆聽新訊息。離開對話後會停止播放。如果缺少語音或語言，請依提示下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話のオプションで自動再生をオンにすると、新着メッセージを読み上げます。会話を閉じると止まります。音声や言語データが必要な場合はダウンロードの案内に従ってください。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa uchezaji wa kiotomatiki katika chaguo za mazungumzo ili kusikia ujumbe mpya. Uchezaji hukoma ukiondoka. Ikiwa sauti au lugha haipo, fuata maelekezo ya kuipakua."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل التشغيل التلقائي من خيارات المحادثة لسماع الرسائل الجديدة. يتوقف التشغيل عند مغادرة المحادثة. إذا لم يتوفر صوت أو لغة، اتبع إرشادات التنزيل."
          }
        }
      }
    },
    "help_status_title": {
