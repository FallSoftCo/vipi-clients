    "help_backup_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Chat backup in Settings. Create an encrypted backup, confirm a new password and choose where to save the file. Keep the password separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Copia de seguridad en Ajustes. Crea una copia cifrada, confirma una contraseña nueva y elige dónde guardar el archivo. Guarda la contraseña por separado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Chatsicherung in den Einstellungen. Erstelle eine verschlüsselte Sicherung, bestätige ein neues Passwort und wähle einen Speicherort. Bewahre das Passwort getrennt auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Sauvegarde des discussions dans Réglages. Créez une sauvegarde chiffrée, confirmez un nouveau mot de passe et choisissez un emplacement. Conservez le mot de passe séparément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Impostazioni apri Backup delle chat. Crea un backup cifrato, conferma una nuova password e scegli dove salvare il file. Conserva la password separatamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Backup das conversas nas Configurações. Crie um backup criptografado, confirme uma nova senha e escolha onde salvar o arquivo. Guarde a senha separadamente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Cópia de segurança nas Definições. Crie uma cópia cifrada, confirme uma nova palavra-passe e escolha onde guardar o ficheiro. Guarde a palavra-passe em separado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Cópia de segurança nas Definições. Crie uma cópia cifrada, confirme uma nova palavra-passe e escolha onde guardar o ficheiro. Guarde a palavra-passe em separado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中打开聊天备份，创建加密备份，确认新密码，然后选择文件的保存位置。请将密码单独保管。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 채팅 백업을 여세요. 암호화된 백업을 만들고 새 비밀번호를 확인한 다음 파일을 저장할 위치를 고르세요. 비밀번호는 따로 보관하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中打開聊天備份，建立加密備份，確認新密碼，然後選擇檔案的儲存位置。請將密碼另外保管。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定のチャットバックアップを開きます。暗号化バックアップを作成し、新しいパスワードを確認して保存先を選びます。パスワードは別に保管してください。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua nakala rudufu ya gumzo katika Mipangilio. Tengeneza nakala iliyosimbwa kwa njia fiche, thibitisha nenosiri jipya na uchague mahali pa kuhifadhi faili. Weka nenosiri kando."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح النسخ الاحتياطي للدردشات في الإعدادات. أنشئ نسخة مشفّرة، وأكّد كلمة مرور جديدة، واختر مكان حفظ الملف. احتفظ بكلمة المرور في مكان منفصل."
          }
        }
      }
    },
    "help_backup_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To restore, sign in to the same account, choose the file and enter its password. Review the summary before confirming. Your backup contains friend chat history. It excludes unsent messages and messaging keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para restaurar, entra con la misma cuenta, elige el archivo, introduce la contraseña y revisa el resumen. La copia guarda el historial con amigos. No incluye mensajes sin enviar ni claves de mensajería."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich zur Wiederherstellung mit demselben Konto an. Wähle die Datei, gib das Passwort ein und prüfe die Zusammenfassung. Gesichert werden Chats mit Freunden. Nicht gesendete Nachrichten und Nachrichtenschlüssel sind ausgenommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour restaurer, connectez-vous au même compte, choisissez le fichier, saisissez son mot de passe et vérifiez le récapitulatif. La sauvegarde contient l’historique avec vos amis. Les messages non envoyés et les clés de messagerie en sont exclus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ripristinare, accedi allo stesso account, seleziona il file, inserisci la password e controlla il riepilogo. Il backup contiene le chat con gli amici. Non include i messaggi non inviati né le chiavi di messaggistica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para restaurar, entre na mesma conta, escolha o arquivo, digite a senha e confira o resumo. O backup inclui o histórico com amigos. Não inclui mensagens não enviadas nem chaves de mensagens."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para restaurar, entre na mesma conta, selecione o ficheiro, introduza a palavra-passe e reveja o resumo. A cópia inclui o histórico com amigos. Exclui mensagens por enviar e chaves de mensagens."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para restaurar, entre na mesma conta, selecione o ficheiro, introduza a palavra-passe e reveja o resumo. A cópia inclui o histórico com amigos. Exclui mensagens por enviar e chaves de mensagens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复时请登录同一账户，选择文件，输入密码，核对摘要后再确认。备份包含与朋友的聊天记录，不含未发送的消息和消息加密密钥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원하려면 같은 계정으로 로그인하고 파일을 선택한 뒤 비밀번호를 입력하세요. 요약을 확인한 후 진행하세요. 백업에는 친구와의 대화 기록이 들어가며, 보내지 않은 메시지와 메시징 키는 제외됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原時請登入同一帳號，選擇檔案、輸入密碼，核對摘要後再確認。備份含有與朋友的聊天記錄，不含未傳送的訊息和通訊金鑰。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元するには同じアカウントでログインし、ファイルを選んでパスワードを入力します。概要を確認してから確定します。友達との履歴が対象で、未送信メッセージや暗号鍵は含まれません。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ili kurejesha, ingia kwenye akaunti ileile, chagua faili na uandike nenosiri lake. Soma muhtasari kabla ya kuthibitisha. Nakala ina historia ya mazungumzo na marafiki. Haina ujumbe ambao haujatumwa wala funguo za mawasiliano."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للاستعادة، سجّل الدخول إلى الحساب نفسه واختر الملف وأدخل كلمة مروره. راجع الملخص قبل التأكيد. تتضمن النسخة سجل الدردشة مع أصدقائك، وتستثني الرسائل التي لم تُرسل ومفاتيح المراسلة."
          }
        }
      }
    },
    "help_groups_title": {
