    "help_safety_step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a friend’s conversation, open the security number. Compare all 12 groups in person or over a trusted call."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la conversación con tu amigo, abre el número de seguridad. Comparad los 12 grupos en persona o mediante una llamada de confianza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Sicherheitsnummer im Chat. Vergleicht alle zwölf Zahlengruppen persönlich oder in einem vertrauenswürdigen Anruf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la conversation, ouvrez le numéro de sécurité. Comparez les 12 groupes en personne ou lors d’un appel de confiance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il numero di sicurezza nella chat con il tuo amico. Confrontate tutti i 12 gruppi di cifre di persona o durante una chiamata fidata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o número de segurança na conversa. Comparem os 12 grupos de dígitos pessoalmente ou em uma ligação confiável."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o número de segurança na conversa. Comparem os 12 grupos de algarismos pessoalmente ou numa chamada de confiança."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o número de segurança na conversa. Comparem os 12 grupos de algarismos pessoalmente ou numa chamada de confiança."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在与朋友的对话中打开安全号码。当面或通过可信的通话核对全部 12 组数字。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구와의 대화에서 보안 번호를 여세요. 직접 만나거나 신뢰할 수 있는 통화로 숫자 12묶음을 모두 비교하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在與朋友的對話中打開安全號碼。當面或透過可信任的通話核對全部 12 組數字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達との会話でセキュリティ番号を開きます。対面か信頼できる通話で、12組の数字をすべて照合します。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Katika mazungumzo na rafiki yako, fungua namba ya usalama. Linganisheni makundi yote 12 ya tarakimu ana kwa ana au kupitia simu mnayoiamini."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح رقم الأمان في محادثتك مع صديقك. قارنا مجموعات الأرقام الاثنتي عشرة وجهًا لوجه أو عبر مكالمة موثوقة."
          }
        }
      }
    },
    "help_safety_step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark it as verified only if every group matches. To block or report someone, open their conversation options. Review exactly what you’re sharing before submitting a report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca el número como verificado solo si coinciden todos los grupos. Puedes bloquear o denunciar desde las opciones de la conversación. Revisa qué vas a compartir antes de enviar una denuncia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige die Nummer nur, wenn alle Gruppen übereinstimmen. In den Chatoptionen kannst du Personen blockieren oder melden. Prüfe vor einer Meldung, was du übermittelst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne validez que si tous les groupes concordent. Pour bloquer ou signaler quelqu’un, ouvrez les options de la conversation. Vérifiez les informations partagées avant d’envoyer un signalement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrassegna il numero come verificato solo se coincide ogni gruppo. Per bloccare o segnalare una persona, apri le opzioni della chat. Controlla cosa condividi prima di inviare la segnalazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque como verificado só se todos os grupos coincidirem. Nas opções da conversa, você pode bloquear ou denunciar alguém. Confira o que será compartilhado antes de enviar a denúncia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque como verificado apenas se todos os grupos coincidirem. Nas opções da conversa pode bloquear ou denunciar alguém. Confira o conteúdo antes de enviar uma denúncia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque como verificado apenas se todos os grupos coincidirem. Nas opções da conversa pode bloquear ou denunciar alguém. Confira o conteúdo antes de enviar uma denúncia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有全部一致时才标记为已验证。通过对话选项可以屏蔽或举报对方。提交举报前请核对将要分享的内容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 일치할 때만 확인됨으로 표시하세요. 대화 옵션에서 상대를 차단하거나 신고할 수 있습니다. 신고하기 전에 공유할 내용을 확인하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有全部相符時才標示為已驗證。從對話選項可以封鎖或檢舉對方。送出檢舉前請確認將分享的內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて一致した場合だけ確認済みにします。ブロックや報告は会話のオプションから行えます。報告を送る前に共有内容を確認してください。"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Weka alama ya kuthibitisha ikiwa makundi yote yanafanana. Unaweza kumzuia au kumripoti mtu kupitia chaguo za mazungumzo. Hakiki taarifa utakazoshiriki kabla ya kutuma ripoti."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تضع علامة التحقق إلا إذا تطابقت جميع المجموعات. يمكنك حظر شخص أو الإبلاغ عنه من خيارات المحادثة. راجع ما ستشاركه قبل إرسال البلاغ."
          }
        }
      }
    },
