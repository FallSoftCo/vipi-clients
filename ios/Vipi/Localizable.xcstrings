    "Bot mini also needs an active Vipi subscription. You can manage both subscriptions below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bot mini también requiere una suscripción activa a Vipi. Puedes gestionar ambas suscripciones abajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bot mini benötigt auch ein aktives Vipi-Abonnement. Sie können beide Abonnements unten verwalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bot mini も有効な Vipi サブスクリプションが必要です。 以下で両方のサブスクリプションを管理できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتاج بوت ميني أيضا إلى اشتراك فيبي نشط. يمكنك إدارة كلا الاشتراكين أدناه."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bot mini도 활성 Vipi 구독이 필요합니다. 아래에서 두 구독을 모두 관리하실 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bot mini还需要有效的Vipi订阅。 您可以在下面管理两个订阅。"
          }
        },
        "zh-Hant": {
