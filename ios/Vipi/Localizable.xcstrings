    "Available words and phrases vary by language. Pronunciation may need a voice download.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available words and phrases vary by language. Pronunciation may need a voice download."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maneno na vifungu vinavyopatikana hutofautiana kulingana na lugha. Kusikiliza matamshi kunaweza kuhitaji kupakua sauti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las palabras y frases disponibles varían según el idioma. La pronunciación puede requerir descargar una voz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verfügbare Wörter und Phrasen variieren je nach Sprache. Die Aussprache kann einen Sprachdownload benötigen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "利用可能な単語やフレーズは言語によって異なります。 発音には音声ダウンロードが必要になる場合があります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تختلف الكلمات والعبارات المتاحة حسب اللغة. قد يحتاج النطق إلى تنزيل صوتي."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사용 가능한 단어와 구문은 언어에 따라 다릅니다. 발음은 음성 다운로드가 필요할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可用的单词和短语因语言而异。 发音可能需要语音下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可用的單詞和短語因語言而異。 發音可能需要語音下載。"
          }
        }
      }
    },
