        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "亲自或通过可信通话与%@比较所有12个组，以确认您的加密密钥匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "親自或通過可信通話與%@比較所有12個組，以確認您的加密密鑰匹配。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قارن جميع المجموعات ال 12 مع %@ شخصيا أو عبر مكالمة موثوقة للتأكد من تطابق مفاتيح التشفير الخاصة بك."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Compare os 12 grupos com %@ pessoalmente ou em uma chamada de confiança para confirmar que suas chaves de criptografia coincidem."
          }
        },
        "pt-PT": {
