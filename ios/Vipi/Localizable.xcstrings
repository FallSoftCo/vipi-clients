    "We couldn’t confirm your subscription. If you completed a purchase, use Restore purchases to check it before buying again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t confirm your subscription. If you completed a purchase, use Restore purchases to check it before buying again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No pudimos confirmar tu suscripción. Si completaste una compra, usa Restaurar compras para comprobarla antes de volver a comprar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wir konnten Ihr Abonnement nicht bestätigen. Wenn Sie einen Kauf abgeschlossen haben, verwenden Sie \"Käufe wiederherstellen\", um ihn zu überprüfen, bevor Sie erneut kaufen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ご契約の確認ができませんでした。 購入が完了した場合は、再度購入する前に「Restore purchases」を使用して確認してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لم نتمكن من تأكيد اشتراكك. إذا أكملت عملية شراء، فاستخدم استعادة المشتريات للتحقق منها قبل الشراء مرة أخرى."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "귀하의 구독을 확인할 수 없습니다. 구매를 완료하셨다면, 다시 구매하기 전에 Restore purchases를 사용하여 확인하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "我们无法确认您的订阅。 如果您已完成购买，请使用“恢复购买”来检查它，然后再再次购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "我們無法確認您的訂閱。 如果您已完成購買，請使用“恢復購買”來檢查它，然後再再次購買。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nous n’avons pas pu confirmer votre abonnement. Si vous avez effectué un achat, utilisez Restaurer les achats pour le vérifier avant d’acheter à nouveau."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hatukuweza kuthibitisha usajili wako. Ikiwa ulikamilisha ununuzi, tumia Rejesha ununuzi kuukagua kabla ya kununua tena."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non siamo riusciti a confermare l’abbonamento. Se hai completato un acquisto, usa Ripristina acquisti per controllarlo prima di acquistare di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível confirmar sua assinatura. Se você concluiu uma compra, use Restaurar compras para verificá-la antes de comprar novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível confirmar sua subscrição. Se você concluiu uma compra, use Restaurar compras para verificá-la antes de comprar novamente."
          }
        }
      }
    },
