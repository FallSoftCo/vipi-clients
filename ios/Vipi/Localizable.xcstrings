    "Reading guides show words in Latin letters. Tap Listen to hear pronunciation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las guías de lectura muestran las palabras en letras latinas. Toca Escuchar para oír la pronunciación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Leseführer zeigen Wörter in lateinischen Buchstaben. Tippen Sie auf \"Hören\", um die Aussprache zu hören."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "読書ガイドはラテン文字で単語を表示します。 「Listen」をタップして発音を聞いてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعرض أدلة القراءة الكلمات بالحروف اللاتينية. اضغط على \"استماع\" لسماع النطق."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "읽기 가이드는 라틴 문자로 단어를 표시합니다. 'Listen'을 탭하여 발음을 들어보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "阅读指南显示拉丁字母的单词。 点击“听”以听发音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "閱讀指南顯示拉丁字母的單詞。 點擊“聽”以聽發音。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les aides à la lecture affichent les mots en caractères latins. Touchez Écouter pour entendre la prononciation."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miongozo ya kusoma huonyesha maneno kwa herufi za Kilatini. Gusa Sikiliza ili kusikia matamshi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le guide alla lettura mostrano le parole in caratteri latini. Tocca Ascolta per sentire la pronuncia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guias de leitura mostram palavras em letras latinas. Toque em Ouvir para escutar a pronúncia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guias de leitura mostram palavras em letras latinas. Toque em Ouvir para escutar a pronúncia."
          }
        }
