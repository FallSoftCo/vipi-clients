    "Sign in again to finish moving your account. The device change you confirmed is saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vuelve a iniciar sesión para terminar de trasladar tu cuenta. Se ha guardado el cambio de dispositivo que confirmaste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Melden Sie sich erneut an, um die Bewegung Ihres Kontos abzuschließen. Die von Ihnen bestätigte Geräteänderung wurde gespeichert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウントの移行を完了するには、再度サインインしてください。 ご確認いただいたデバイスの変更は保存されています。"
          }
