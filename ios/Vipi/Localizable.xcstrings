    "Your messages appear in %@, translated on this device. Bot mini is optional and billed separately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Your messages appear in %@, translated on this device. Bot mini is optional and billed separately."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تظهر رسائلك باللغة %@، وتُترجم على هذا الجهاز. Bot mini اختياري وتُدفع رسومه بشكل منفصل."
