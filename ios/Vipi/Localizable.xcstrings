    "The active device changed again. Review this device once more before replacing it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El dispositivo activo ha vuelto a cambiar. Revisa este dispositivo otra vez antes de sustituirlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das aktive Gerät hat sich erneut geändert. Überprüfen Sie dieses Gerät noch einmal, bevor Sie es austauschen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アクティブなデバイスが再び変わりました。 このデバイスを交換する前に、もう一度ご確認ください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تغير الجهاز النشط مرة أخرى. راجع هذا الجهاز مرة أخرى قبل استبداله."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "활성 장치가 다시 변경되었습니다. 교체하기 전에 이 장치를 다시 한 번 검토하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "活动设备再次更改。 在更换之前，请再次检查此设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "活動設備再次更改。 在更換之前，請再次檢查此設備。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’appareil actif a de nouveau changé. Vérifiez à nouveau cet appareil avant de le remplacer."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kifaa kinachotumika kimebadilika tena. Kagua kifaa hiki tena kabla ya kukibadilisha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il dispositivo attivo è cambiato di nuovo. Verifica ancora questo dispositivo prima di sostituirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O dispositivo ativo mudou novamente. Revise este dispositivo mais uma vez antes de substituí-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O dispositivo ativo mudou novamente. Revise este dispositivo mais uma vez antes de substituí-lo."
          }
        }
      }
    },
    "The currently active device will be signed out. Saved history remains, but pending old messages won’t be resent.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se cerrará la sesión en el dispositivo activo actual. El historial guardado permanece, pero los mensajes antiguos pendientes no se reenviarán."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das derzeit aktive Gerät wird abgemeldet. Der gespeicherte Verlauf bleibt bestehen, aber ausstehende alte Nachrichten werden nicht erneut gesendet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "現在アクティブなデバイスはサインアウトされます。 保存された履歴は残りますが、保留中の古いメッセージは再送されません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيتم تسجيل الخروج من الجهاز النشط حاليا. لا يزال السجل المحفوظ قائما، ولكن لن يتم إعادة إرسال الرسائل القديمة المعلقة."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "현재 활성화된 기기가 로그아웃됩니다. 저장된 기록은 남아 있지만, 보류 중인 오래된 메시지는 다시 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当前活跃的设备将被注销。 保存的历史记录仍然存在，但待处理的旧消息将不会被重新发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "當前活躍的設備將被註銷。 保存的歷史記錄仍然存在，但待處理的舊消息將不會被重新發送。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’appareil actuellement actif sera déconnecté. L’historique enregistré reste disponible, mais les anciens messages en attente ne seront pas renvoyés."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kifaa kinachotumika sasa kitaondolewa kwenye akaunti. Historia iliyohifadhiwa inabaki, lakini ujumbe wa zamani unaosubiri hautatumwa tena."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il dispositivo attualmente attivo verrà disconnesso. La cronologia salvata rimane, ma i vecchi messaggi in attesa non verranno reinviati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O dispositivo ativo atual será desconectado. O histórico salvo permanece, mas mensagens antigas pendentes não serão reenviadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O dispositivo ativo atual será desconectado. O histórico guardado permanece, mas mensagens antigas pendentes não serão reenviadas."
          }
        }
      }
    },
    "The keys may have changed, or your choice couldn’t be saved. Compare the current numbers again.": {
      "localizations": {
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Huenda funguo zimebadilika au chaguo lako halikuhifadhiwa. Linganisha nambari za sasa tena."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puede que las claves hayan cambiado o que no se haya podido guardar tu elección. Compara de nuevo los números actuales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Schlüssel haben sich möglicherweise geändert oder Ihre Auswahl konnte nicht gespeichert werden. Vergleichen Sie die aktuellen Zahlen erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "キーが変更されたか、選択が保存できなかった可能性があります。 現在の数値を再度比較してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ربما تكون المفاتيح قد تغيرت، أو تعذر حفظ اختيارك. قارن الأرقام الحالية مرة أخرى."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "키가 변경되었거나 선택을 저장할 수 없었을 수도 있습니다. 현재 수치를 다시 비교하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "密钥可能已更改，或您的选择未能保存。请再次比对当前号码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "金鑰可能已變更，或您的選擇未能儲存。請再次比對目前的號碼。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les clés ont peut-être changé ou votre choix n’a pas pu être enregistré. Comparez à nouveau les nombres actuels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le chiavi potrebbero essere cambiate o la tua scelta potrebbe non essere stata salvata. Confronta di nuovo i numeri attuali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As chaves podem ter mudado ou sua escolha não pôde ser salva. Compare novamente os números atuais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As chaves podem ter mudado ou sua escolha não pôde ser guardada. Compare novamente os números atuais."
          }
        }
      }
    },
    "Then %@ per year. Renews annually until you cancel.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Después, %@ al año. Se renueva anualmente hasta que canceles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puis %@ par an. Renouvellement annuel jusqu’à annulation."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kisha %@ kwa mwaka. Usajili unajisasisha kila mwaka hadi uughairi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poi %@ all’anno. Si rinnova annualmente fino all’annullamento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dann %@ pro Jahr. Verlängert sich jährlich, bis Sie kündigen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "それから、%@は年間です。 キャンセルされるまで、毎年更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그럼 %@는 연간입니다. 취소하실 때까지 매년 갱신됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "然后每年%@。 每年续订，直到您取消为止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "然後每年%@。 每年續訂，直到您取消為止。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ثم %@ سنويا. يتجدد سنويا حتى تقوم بالإلغاء."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Depois, %@ por ano. Renova anualmente até você cancelar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Depois, %@ por ano. Renova anualmente até você cancelar."
          }
        }
      }
    },
    "These downloads are for optional full-message translation. Word switching does not need them. To translate a whole message, choose Full translation in its reading options. Messages stay on this device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Estas descargas son para la traducción opcional de mensajes completos. El cambio de palabras no las necesita. Para traducir todo un mensaje, elige Traducción completa en sus opciones de lectura. Los mensajes permanecen en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Downloads sind für die optionale Übersetzung von Vollnachrichten. Der Wortwechsel braucht sie nicht. Um eine ganze Nachricht zu übersetzen, wählen Sie \"Vollständige Übersetzung\" in den Leseoptionen. Nachrichten bleiben auf diesem Gerät."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これらのダウンロードは、オプションのフルメッセージ翻訳用です。 単語の切り替えにはそれらは必要ありません。 メッセージ全体を翻訳するには、閲覧オプションで「Full translation」を選択してください。 メッセージはこのデバイスに残ります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذه التنزيلات مخصصة لترجمة الرسالة الكاملة الاختيارية. تبديل الكلمات لا يحتاج إليها. لترجمة رسالة كاملة، اختر الترجمة الكاملة في خيارات القراءة الخاصة بها. تبقى الرسائل على هذا الجهاز."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 다운로드는 선택적인 전체 메시지 번역을 위한 것입니다. 단어 전환은 필요하지 않습니다. 전체 메시지를 번역하려면 읽기 옵션에서 “전체 번역”을 선택하십시오. 메시지는 이 기기에 남아 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "这些下载用于可选的完整信息翻译。 单词切换不需要它们。 要翻译整个消息，请在其阅读选项中选择“完整翻译”。 信息会保留在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這些下載用於可選的完整信息翻譯。 單詞切換不需要它們。 要翻譯整個消息，請在其閱讀選項中選擇“完整翻譯”。 信息會保留在此設備上。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces téléchargements servent à la traduction facultative de messages complets. Le changement de mots n’en a pas besoin. Pour traduire un message entier, choisissez Traduction complète dans ses options de lecture. Les messages restent sur cet appareil."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vipakuliwa hivi ni vya kutafsiri ujumbe mzima ukichagua kufanya hivyo. Kubadilisha maneno hakuvihitaji. Kutafsiri ujumbe mzima, chagua Tafsiri kamili kwenye chaguo zake za kusoma. Ujumbe unabaki kwenye kifaa hiki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questi download servono alla traduzione facoltativa dei messaggi completi. Il cambio delle parole non ne ha bisogno. Per tradurre un messaggio intero, scegli Traduzione completa nelle sue opzioni di lettura. I messaggi restano su questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esses downloads são para a tradução opcional de mensagens completas. A troca de palavras não precisa deles. Para traduzir uma mensagem inteira, escolha Tradução completa nas opções de leitura. As mensagens permanecem neste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esses downloads são para a tradução opcional de mensagens completas. A troca de palavras não precisa deles. Para traduzir uma mensagem inteira, escolha Tradução completa nas opções de leitura. As mensagens permanecem neste dispositivo."
          }
        }
      }
    },
    "This device will replace whichever other device is currently active and sign it out. A recent sign-in is required.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este dispositivo sustituirá a cualquier otro que esté activo y cerrará su sesión. Es necesario iniciar sesión recientemente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Gerät ersetzt das andere Gerät, das derzeit aktiv ist, und meldet es ab. Eine kürzliche Anmeldung ist erforderlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このデバイスは、現在アクティブな他のデバイスを置き換え、サインアウトします。 最近のサインインが必要です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيحل هذا الجهاز محل أي جهاز آخر نشط حاليا وتسجيل الخروج منه. مطلوب تسجيل دخول حديث."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 장치는 현재 활성화된 다른 장치를 교체하고 로그아웃합니다. 최근 로그인이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此设备将替换当前处于活动状态的任何其他设备，并退出登录。 需要最近登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此設備將替換當前處於活動狀態的任何其他設備，並退出登錄。 需要最近登錄。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet appareil remplacera tout autre appareil actuellement actif et le déconnectera. Une connexion récente est nécessaire."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kifaa hiki kitachukua nafasi ya kifaa kingine kinachotumika sasa na kukiondoa kwenye akaunti. Lazima uwe umeingia hivi karibuni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo dispositivo sostituirà qualsiasi altro dispositivo attualmente attivo e lo disconnetterà. È richiesto un accesso recente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este dispositivo substituirá qualquer outro que esteja ativo e o desconectará. É necessário ter entrado recentemente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este dispositivo substituirá qualquer outro que esteja ativo e o desconectará. É necessário ter entrado recentemente."
          }
        }
      }
    },
    "This is a separate subscription, in addition to Vipi.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta es una suscripción independiente, además de Vipi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dies ist ein separates Abonnement, zusätzlich zu Vipi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これは、Vipiに加えて別のサブスクリプションです。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هذا اشتراك منفصل، بالإضافة إلى Vipi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이것은 Vipi 외에 별도의 구독입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "除了Vipi之外，这是一个单独的订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "除了Vipi之外，這是一個單獨的訂閱。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il s’agit d’un abonnement distinct, en plus de Vipi."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Huu ni usajili tofauti, wa ziada ya Vipi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo è un abbonamento separato, aggiuntivo rispetto a Vipi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta é uma assinatura separada, além do Vipi."
          }
