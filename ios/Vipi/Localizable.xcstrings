    "Encryption details couldn’t be opened. Your verification hasn’t changed.": {
      "localizations": {
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hatukuweza kufungua maelezo ya usimbaji fiche. Uthibitisho wako haujabadilika."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudieron abrir los detalles de cifrado. Tu verificación no ha cambiado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verschlüsselungsdetails konnten nicht geöffnet werden. Ihre Verifizierung hat sich nicht geändert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "暗号化の詳細を開くことができませんでした。 お客様の認証は変更されていません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذر فتح تفاصيل التشفير. لم يتغير التحقق الخاص بك."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "암호화 세부 정보를 열 수 없습니다. 귀하의 인증은 변경되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法打开加密详细信息。 您的验证没有改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法打開加密詳細信息。 您的驗證沒有改變。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible d’ouvrir les détails de chiffrement. Votre vérification n’a pas changé."
