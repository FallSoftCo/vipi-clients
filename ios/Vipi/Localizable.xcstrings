    "Sign in to Vipi again, then connect your Fallsoft login. Your chats, profile and original trial stay with you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to Vipi again, then connect your Fallsoft login. Your chats, profile and original trial stay with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vuelve a iniciar sesión en Vipi y después conecta tu cuenta de Fallsoft. Conservarás tus chats, tu perfil y tu periodo de prueba original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reconnectez-vous à Vipi, puis associez votre compte Fallsoft. Vos discussions, votre profil et votre période d’essai initiale sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Melde dich erneut bei Vipi an und verknüpfe dann dein Fallsoft-Konto. Deine Chats, dein Profil und deine ursprüngliche Testphase bleiben erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accedi di nuovo a Vipi, poi collega il tuo account Fallsoft. Le chat, il profilo e il periodo di prova originale resteranno con te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entre novamente no Vipi e depois vincule sua conta Fallsoft. Suas conversas, seu perfil e o período de teste original serão mantidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicie sessão novamente no Vipi e depois associe a sua conta Fallsoft. As suas conversas, o perfil e o período de teste original serão mantidos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vipiにもう一度ログインしてから、Fallsoftのアカウントを連携します。チャット、プロフィール、元の試用期間はそのまま引き継がれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vipi에 다시 로그인한 다음 Fallsoft 계정을 연결하세요. 채팅, 프로필 및 기존 체험 기간은 그대로 유지됩니다."
          }
        },
        "zh-Hans": {
