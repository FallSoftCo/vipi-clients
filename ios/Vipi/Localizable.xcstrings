      }
    },
    "Review access is active. No subscription is required for this account.": {
      "localizations": {
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akaunti hii inaweza kutumiwa kwa ukaguzi. Haihitaji usajili wa kulipia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El acceso de revisión está activo. Esta cuenta no requiere suscripción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Überprüfungszugriff ist aktiv. Für dieses Konto ist kein Abonnement erforderlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "レビューへのアクセスが有効です。 このアカウントにはサブスクリプションは必要ありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الوصول إلى المراجعة نشط. لا يوجد اشتراك مطلوب لهذا الحساب."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "검토 접근 권한이 활성화되었습니다. 이 계정은 구독이 필요하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "审核访问权限处于活动状态。 该帐户不需要订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "審核訪問權限處於活動狀態。 該帳戶不需要訂閱。"
          }
        }
      }
    },
    "Save your friend chat history in an encrypted file, wherever you choose to keep it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Guarda el historial de chats con amigos en un archivo cifrado, donde prefieras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Speichern Sie den Chat-Verlauf Ihres Freundes in einer verschlüsselten Datei, wo immer Sie ihn behalten möchten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "友達のチャット履歴を暗号化されたファイルに保存し、保存したい場所に保存してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "احفظ سجل دردشة أصدقائك في ملف مشفر، أينما اخترت الاحتفاظ به."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "친구 채팅 기록을 암호화된 파일에 저장하고, 원하는 위치에 저장하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在您選擇保留的任何地方，將朋友的聊天记录儲存在加密文件中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在您選擇保留的任何地方，將朋友的聊天記錄儲存在加密文件中。"
          }
        }
      }
    },
    "Say hello. Your messages are end-to-end encrypted.": {
      "localizations": {
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sema habari. Ujumbe wako una usimbaji fiche kutoka mwanzo hadi mwisho."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saluda. Tus mensajes están cifrados de extremo a extremo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sag Hallo. Ihre Nachrichten sind Ende-zu-Ende verschlüsselt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "こんにちはと言ってください。 お客様のメッセージはエンドツーエンドで暗号化されています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قل مرحبا. رسائلك مشفرة من طرف إلى طرف."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "인사하세요. 귀하의 메시지는 종단 간 암호화됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打个招呼。 您的消息是端到端加密的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打個招呼。 您的消息是端到端加密的。"
          }
        }
      }
    },
    "Selected words and short phrases switch between your language and the language you choose. Word order and grammar stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected words and short phrases switch between your language and the language you choose. Word order and grammar stay the same."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maneno yaliyochaguliwa na vifungu vifupi hubadilika kati ya lugha yako na lugha unayochagua. Mpangilio wa maneno na sarufi hubaki vilevile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las palabras y frases cortas seleccionadas cambian entre tu idioma y el que elijas. El orden de las palabras y la gramática no cambian."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ausgewählte Wörter und kurze Phrasen wechseln zwischen Ihrer Sprache und der von Ihnen gewählten Sprache. Wortstellung und Grammatik bleiben gleich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選択した単語や短いフレーズは、あなたの言語と選択した言語の間で切り替わります。 語順と文法は変わりません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنتقل الكلمات والعبارات القصيرة المختارة بين لغتك واللغة التي تختارها. يبقى ترتيب الكلمات والقواعد النحوية كما هي."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택한 단어와 짧은 구절은 귀하의 언어와 선택한 언어 사이를 전환합니다. 어순과 문법은 동일하게 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选定的单词和短句在您的语言和您选择的语言之间切换。 词序和语法保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選定的單詞和短句在您的語言和您選擇的語言之間切換。 詞序和語法保持不變。"
          }
        }
      }
    },
    "Send only the reply shown above and your selected reason to Vipi. Reports are stored encrypted for up to 30 days. Your other messages aren’t included.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envía a Vipi solo la respuesta mostrada arriba y el motivo seleccionado. Los informes se guardan cifrados hasta 30 días. Tus otros mensajes no se incluyen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Senden Sie nur die oben gezeigte Antwort und den von Ihnen ausgewählten Grund an Vipi. Berichte werden bis zu 30 Tage lang verschlüsselt gespeichert. Ihre anderen Nachrichten sind nicht enthalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "上記の返信と選択した理由のみをVipiに送信してください。 レポートは最大30日間暗号化されて保存されます。 他のメッセージは含まれておりません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أرسل فقط الرد الموضح أعلاه والسبب الذي اخترته إلى فيبي. يتم تخزين التقارير مشفرة لمدة تصل إلى 30 يوما. لا يتم تضمين رسائلك الأخرى."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "위에 표시된 답변과 선택한 사유만 Vipi에 보내십시오. 보고서는 최대 30일 동안 암호화된 상태로 저장됩니다. 다른 메시지는 포함되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅将上面显示的回复和您选择的理由发送给Vipi。 报告经过加密存储长达30天。 您的其他消息不包括在内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅將上面顯示的回復和您選擇的理由發送給Vipi。 報告經過加密存儲長達30天。 您的其他消息不包括在內。"
          }
        }
      }
    },
