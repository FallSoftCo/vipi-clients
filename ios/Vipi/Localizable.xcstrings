        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتم التحقق من الوصول إلى Chatbot. يرجى المحاولة مرة أخرى لاحقا."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "챗봇 접근이 확인 중입니다. 잠시 후에 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
