    "Find a friend by username and send a message. Supported words and phrases will switch into %@ as you read.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Busca a un amigo por su nombre de usuario y envíale un mensaje. Las palabras y frases compatibles cambiarán a %@ mientras lees."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trouvez un ami par son nom d’utilisateur et envoyez-lui un message. Les mots et expressions pris en charge passeront en %@ pendant votre lecture."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tafuta rafiki kwa jina la mtumiaji na utume ujumbe. Maneno na vifungu vinavyopatikana vitabadilika kwenda %@ unaposoma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trova un amico tramite il nome utente e inviagli un messaggio. Le parole e le frasi supportate passeranno a %@ mentre leggi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Finden Sie einen Freund nach Benutzername und senden Sie eine Nachricht. Unterstützte Wörter und Phrasen wechseln während des Lesens in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ユーザー名で友達を検索し、メッセージを送信してください。 サポートされている単語やフレーズは、読んでいるにつれて%@に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사용자 이름으로 친구를 찾아 메시지를 보내세요. 지원되는 단어와 구문은 읽는 동안 %@로 전환됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按用户名查找朋友并发送消息。 支持的单词和短语将在您阅读时切换到%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用使用者名稱尋找朋友並傳送訊息。閱讀時，支援的單字和短語會切換成 %@。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ابحث عن صديق باسم المستخدم وأرسل رسالة. ستتحول الكلمات والعبارات المدعومة إلى %@ أثناء القراءة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encontre um amigo pelo nome de usuário e envie uma mensagem. Palavras e frases compatíveis mudarão para %@ enquanto você lê."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encontre um amigo pelo nome de utilizador e envie uma mensagem. Palavras e frases compatíveis mudarão para %@ enquanto você lê."
          }
        }
      }
    },
