    "Use 3–24 letters, numbers or underscores, starting with a letter.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 3–24 letters, numbers or underscores, starting with a letter."
          }
        },
        "sw": {
          "stringUnit": {
