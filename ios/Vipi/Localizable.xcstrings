    "You can exchange new messages again. Stopped messages won’t be resent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can exchange new messages again. Stopped messages won’t be resent."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mnaweza kutumiana ujumbe mpya tena. Ujumbe uliositishwa hautatumwa tena."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podéis intercambiar mensajes nuevos de nuevo. Los mensajes detenidos no se reenviarán."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie können wieder neue Nachrichten austauschen. Gestoppte Nachrichten werden nicht erneut gesendet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "新しいメッセージを再度やり取りできます。 停止されたメッセージは再送されません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكنك تبادل الرسائل الجديدة مرة أخرى. لن يتم إعادة إرسال الرسائل المتوقفة."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "새로운 메시지를 다시 교환하실 수 있습니다. 중단된 메시지는 다시 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您可以再次交换新消息。 停止的消息不会被重新发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您可以再次交換新消息。 停止的消息不會被重新發送。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous pouvez de nouveau échanger de nouveaux messages. Les messages arrêtés ne seront pas renvoyés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Potete scambiare di nuovo nuovi messaggi. I messaggi interrotti non verranno reinviati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
