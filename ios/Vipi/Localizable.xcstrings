          }
        }
      }
    },
    "Chat with me on Vipi and learn words as we talk. My username is @%@. After signing in, choose New chat and find my username.\n%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat with me on Vipi and learn words as we talk. My username is @%@. After signing in, choose New chat and find my username.\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chatea conmigo en Vipi y aprende palabras mientras hablamos. Mi nombre de usuario es @%@. Después de iniciar sesión, elige Nuevo chat y busca mi nombre de usuario.\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Discutez avec moi sur Vipi et apprenez des mots au fil de nos échanges. Mon nom d’utilisateur est @%@. Après connexion, choisissez Nouvelle discussion et recherchez mon nom d’utilisateur.\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chatta con me su Vipi e impara parole mentre parliamo. Il mio nome utente è @%@. Dopo aver effettuato l’accesso, scegli Nuova chat e cerca il mio nome utente.\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Converse comigo no Vipi e aprenda palavras enquanto falamos. Meu nome de usuário é @%@. Depois de entrar, escolha Nova conversa e procure meu nome de usuário.\n%@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Converse comigo no Vipi e aprenda palavras enquanto falamos. O meu nome de utilizador é @%@. Depois de iniciar sessão, escolha Nova conversa e procure o meu nome de utilizador.\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chatte mit mir auf Vipi und lerne beim Chatten Wörter. Mein Nutzername ist @%1$@. Melde dich an, wähle „Neuer Chat“ und suche meinen Nutzernamen.\n%2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vipiで話しながら一緒に単語を学びましょう。私のユーザー名は@%1$@です。サインイン後、「新しいチャット」を選び、私のユーザー名を検索してください。\n%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vipi에서 대화하며 단어를 배워요. 제 사용자 이름은 @%1$@입니다. 로그인한 후 새 채팅을 선택하고 제 사용자 이름을 찾아 주세요.\n%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "来 Vipi 和我聊天，一边聊天一边学习单词。我的用户名是 @%1$@。登录后，选择“新聊天”并搜索我的用户名。\n%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "來 Vipi 和我聊天，一邊聊天一邊學習單字。我的使用者名稱是 @%1$@。登入後，選擇「新聊天」並搜尋我的使用者名稱。\n%2$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تحدث معي على Vipi وتعلّم كلمات أثناء محادثتنا. اسم المستخدم الخاص بي هو @%1$@. بعد تسجيل الدخول، اختر محادثة جديدة وابحث عن اسم المستخدم الخاص بي.\n%2$@"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zungumza nami kwenye Vipi na ujifunze maneno tunapozungumza. Jina langu la mtumiaji ni @%@. Baada ya kuingia, chagua Mazungumzo mapya na utafute jina langu la mtumiaji.\n%@"
          }
        }
      }
    },
