          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "رسائلك مشفّرة من طرف إلى طرف. يرى أصدقاؤك اسم المستخدم فقط، ولا يرون بريدك الإلكتروني."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ujumbe wako umesimbwa kwa njia fiche kutoka mwisho hadi mwisho. Marafiki wanaona jina lako la mtumiaji, si barua pepe yako."
          }
        }
      }
    },
