    "Your messages are end-to-end encrypted. Friends see your username, never your email.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tus mensajes están cifrados de extremo a extremo. Tus amigos ven tu nombre de usuario, nunca tu correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos messages sont chiffrés de bout en bout. Vos amis voient votre nom d’utilisateur, jamais votre e-mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Nachrichten sind Ende-zu-Ende-verschlüsselt. Freunde sehen deinen Benutzernamen, nie deine E-Mail-Adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I tuoi messaggi sono crittografati end-to-end. Gli amici vedono il tuo nome utente, mai la tua email."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suas mensagens têm criptografia de ponta a ponta. Seus amigos veem seu nome de usuário, nunca seu e-mail."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As tuas mensagens têm encriptação ponto a ponto. Os teus amigos veem o teu nome de utilizador, nunca o teu e-mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "メッセージはエンドツーエンドで暗号化されます。友達に表示されるのはユーザー名だけで、メールアドレスは表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "메시지는 종단 간 암호화됩니다. 친구에게는 사용자 이름만 보이고 이메일은 공개되지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "消息采用端到端加密。朋友只能看到你的用户名，看不到邮箱。"
