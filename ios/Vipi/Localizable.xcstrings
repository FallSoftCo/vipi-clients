    "We can’t verify your subscription right now. Please try again later. Checking won’t start a new purchase.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can’t verify your subscription right now. Please try again later. Checking won’t start a new purchase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dein Abonnement kann gerade nicht überprüft werden. Bitte versuche es später erneut. Durch die Prüfung wird kein neuer Kauf ausgelöst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "現在、サブスクリプションを確認できません。後でもう一度お試しください。確認によって新たな購入が開始されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "지금은 구독을 확인할 수 없습니다. 나중에 다시 시도해 주세요. 확인만으로 새 구매가 시작되지는 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "目前无法验证您的订阅，请稍后重试。检查不会发起新的购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "目前無法驗證您的訂閱，請稍後再試。檢查不會發起新的購買。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكننا التحقق من اشتراكك الآن. يُرجى المحاولة لاحقًا. لن يبدأ التحقق عملية شراء جديدة."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hatuwezi kuthibitisha usajili wako kwa sasa. Tafadhali jaribu tena baadaye. Kukagua hakutaanzisha ununuzi mpya."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No podemos verificar tu suscripción ahora mismo. Inténtalo más tarde. Comprobarlo no iniciará una nueva compra."
          }
        }
      }
    },
    "Chatbot access is being checked. Please try again later.": {
