    "Use 3–24 English letters, numbers or underscores. Start with a letter. Your phone number and contacts stay private.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa entre 3 y 24 letras inglesas, números o guiones bajos. Empieza con una letra. Tu número de teléfono y tus contactos permanecen privados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez 3 à 24 lettres anglaises, chiffres ou caractères de soulignement. Commencez par une lettre. Votre numéro de téléphone et vos contacts restent privés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa da 3 a 24 lettere inglesi, numeri o trattini bassi. Inizia con una lettera. Il numero di telefono e i contatti restano privati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use de 3 a 24 letras inglesas, números ou sublinhados. Comece com uma letra. Seu número de telefone e seus contatos permanecem privados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilize 3 a 24 letras inglesas, números ou sublinhados. Comece por uma letra. O seu número de telefone e os seus contactos permanecem privados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwenden Sie 3–24 englische Buchstaben, Ziffern oder Unterstriche. Beginnen Sie mit einem Buchstaben. Ihre Telefonnummer und Kontakte bleiben privat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "英字、数字、アンダースコアを3〜24文字使い、英字から始めてください。電話番号と連絡先は非公開です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "영문자, 숫자 또는 밑줄을 3~24자 사용하고 영문자로 시작하세요. 전화번호와 연락처는 비공개로 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用3至24个英文字母、数字或下划线，并以英文字母开头。您的电话号码和联系人保持私密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用3至24個英文字母、數字或底線，並以英文字母開頭。您的電話號碼和聯絡人保持私密。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدم من 3 إلى 24 حرفًا إنجليزيًا أو رقمًا أو شرطة سفلية. ابدأ بحرف إنجليزي. يظل رقم هاتفك وجهات اتصالك خاصّين."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tumia vibambo 3–24: herufi za Kiingereza, nambari au alama ya mstari wa chini. Anza kwa herufi ya Kiingereza. Nambari yako ya simu na anwani zako hubaki kuwa za faragha."
          }
        }
      }
    },
