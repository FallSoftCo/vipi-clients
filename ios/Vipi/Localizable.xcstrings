    "Tap a highlighted word to hear it in your practice language. In chats, tap a bubble to translate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tap a highlighted word to hear it in your practice language. In chats, tap a bubble to translate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca una palabra resaltada para oírla en el idioma que estás aprendiendo. En los chats, toca una burbuja para traducir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez un mot surligné pour l’entendre dans la langue que vous apprenez. Dans les chats, touchez une bulle pour traduire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe auf ein markiertes Wort, um es in der Sprache zu hören, die du lernst. Tippe im Chat auf eine Sprechblase zum Übersetzen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tocca una parola evidenziata per ascoltarla nella lingua che stai imparando. Nelle chat, tocca un fumetto per tradurre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque em uma palavra destacada para ouvi-la no idioma que você está aprendendo. Nas conversas, toque em um balão para traduzir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca numa palavra destacada para a ouvires na língua que estás a aprender. Nas conversas, toca num balão para traduzir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ハイライトされた単語をタップすると、学習中の言語での発音を聞けます。チャットでは、吹き出しをタップすると翻訳されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "강조된 단어를 누르면 학습 중인 언어로 발음을 들을 수 있어요. 채팅에서는 말풍선을 누르면 번역돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "点按高亮单词，即可听到它在所学语言中的发音。在聊天中，点按气泡即可翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "點一下反白單字，即可聽到它在所學語言中的發音。在聊天中，點一下對話氣泡即可翻譯。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اضغط على كلمة مميزة لسماع نطقها باللغة التي تتعلمها. في الدردشات، اضغط على فقاعة للترجمة."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gusa neno lililoangaziwa ili kusikia matamshi yake katika lugha unayojifunza. Kwenye mazungumzo, gusa kiputo ili kutafsiri."
          }
        }
      }
    },
    "Your Fallsoft sign-in and accounts in other Fallsoft apps will remain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Fallsoft sign-in and accounts in other Fallsoft apps will remain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu acceso a Fallsoft y tus cuentas en otras apps de Fallsoft se conservarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre accès à Fallsoft et vos comptes dans les autres apps Fallsoft seront conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihr Fallsoft-Zugang und Ihre Konten in anderen Fallsoft-Apps bleiben erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il tuo accesso Fallsoft e i tuoi account nelle altre app Fallsoft verranno mantenuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seu acesso à Fallsoft e suas contas em outros apps da Fallsoft serão mantidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O seu acesso à Fallsoft e as suas contas noutras apps da Fallsoft serão mantidos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fallsoftへのログインと、ほかのFallsoftアプリのアカウントは引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fallsoft 로그인 계정과 다른 Fallsoft 앱의 계정은 그대로 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您的 Fallsoft 登录账号及其他 Fallsoft 应用中的账户将保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您的 Fallsoft 登入帳號與其他 Fallsoft 應用程式中的帳號都會保留。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيبقى حسابك لتسجيل الدخول إلى Fallsoft وحساباتك في تطبيقات Fallsoft الأخرى."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akaunti yako ya kuingia kwenye Fallsoft na akaunti zako katika programu nyingine za Fallsoft zitabaki."
          }
        }
      }
    },
