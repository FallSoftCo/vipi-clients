          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wir konnten diesen Bericht nicht bestätigen. Der erneute Versuch sendet denselben Bericht, ohne ein Duplikat zu erstellen."
          }
