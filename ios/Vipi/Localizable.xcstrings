    "We couldn’t confirm this report. Retrying sends the same report without creating a duplicate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t confirm this report. Retrying sends the same report without creating a duplicate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No pudimos confirmar esta denuncia. Al reintentar se envía la misma denuncia sin crear un duplicado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nous n’avons pas pu confirmer ce signalement. Réessayer envoie le même signalement sans créer de doublon."
          }
        },
        "it": {
          "stringUnit": {
