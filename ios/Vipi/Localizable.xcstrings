        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tafadhali ingia tena ili kuunganisha akaunti yako upya. Mazungumzo uliyohifadhi bado yako kwenye kifaa hiki."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vuelve a iniciar sesión para reconectar tu cuenta. Tus conversaciones guardadas siguen en este dispositivo."
