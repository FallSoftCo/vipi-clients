          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nous ne pouvons pas vérifier votre abonnement pour le moment. Réessayez plus tard. La vérification ne lance pas un nouvel achat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al momento non possiamo verificare il tuo abbonamento. Riprova più tardi. Il controllo non avvia un nuovo acquisto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
