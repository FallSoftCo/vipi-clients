    "Choose how many new words appear. Words you’ve seen can keep appearing too, so the total can grow. Set to 0% to turn word switching off.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige cuántas palabras nuevas aparecen. Las palabras que ya viste también pueden seguir apareciendo, por lo que el total puede aumentar. Elige 0 % para desactivar el cambio de palabras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wähle, wie viele neue Wörter erscheinen. Bereits gesehene Wörter können weiterhin erscheinen, sodass die Gesamtzahl steigen kann. Stelle 0 % ein, um den Wortwechsel auszuschalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "表示する新しい単語の量を選びます。見たことのある単語も引き続き表示されるため、合計は増えることがあります。単語の切り替えをオフにするには0%に設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "표시할 새 단어의 양을 선택하세요. 전에 본 단어도 계속 표시될 수 있어 전체 단어 수가 늘어날 수 있습니다. 단어 전환을 끄려면 0%로 설정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择显示多少新词。您见过的词也可能继续出现，因此总数可能增加。设为 0% 可关闭词语切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇顯示多少新詞。您看過的詞也可能繼續出現，因此總數可能增加。設為 0% 可關閉詞語切換。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر مقدار الكلمات الجديدة التي تظهر. قد تستمر الكلمات التي رأيتها في الظهور أيضًا، لذلك قد يزداد الإجمالي. اضبط النسبة على 0% لإيقاف تبديل الكلمات."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez le nombre de mots nouveaux affichés. Les mots déjà vus peuvent continuer à apparaître : le total peut donc augmenter. Réglez sur 0 % pour désactiver le changement des mots."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chagua maneno mapya yaonekane kwa kiasi gani. Maneno uliyoyaona awali yanaweza kuendelea kuonekana pia, hivyo jumla inaweza kuongezeka. Weka 0% ili kuzima kubadilisha maneno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli quante parole nuove visualizzare. Anche le parole già viste possono continuare ad apparire, quindi il totale può aumentare. Imposta 0% per disattivare il cambio delle parole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha quantas palavras novas aparecem. Palavras já vistas também podem continuar aparecendo, então o total pode aumentar. Defina 0% para desativar a troca de palavras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha quantas palavras novas aparecem. Palavras já vistas também podem continuar aparecendo, então o total pode aumentar. Defina 0% para desativar a troca de palavras."
          }
        }
      }
    },
