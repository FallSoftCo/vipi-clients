    },
    "Removing a language frees storage. You can download it again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eliminar un idioma libera espacio. Puedes descargarlo de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Entfernen einer Sprache befreit Speicherplatz. Sie können es erneut herunterladen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "言語を削除すると、ストレージが解放されます。 再度ダウンロードできます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إزالة اللغة يحرر التخزين. يمكنك تنزيله مرة أخرى."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "언어를 제거하면 저장 공간이 확보됩니다. 다시 다운로드하실 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "删除语言可以释放存储空间。 你可以再次下载它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "刪除語言可以釋放存儲空間。 你可以再次下載它。"
          }
        }
      }
    },
    "Renews annually until you cancel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird jährlich verlängert, bis du kündigst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "キャンセルするまで毎年更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "취소할 때까지 매년 갱신됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每年自动续订，直至您取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每年自動續訂，直到您取消。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتجدد سنويًا حتى تلغيه."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hujisasisha kila mwaka hadi ughairi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se renueva anualmente hasta que canceles."
          }
        }
      }
    },
    "Renews annually until you cancel. Any available introductory offer is confirmed by the App Store.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se renueva anualmente hasta que canceles. El App Store confirma cualquier oferta introductoria disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verlängert sich jährlich, bis Sie kündigen. Alle verfügbaren Einführungsangebote werden vom App Store bestätigt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "キャンセルされるまで、毎年更新されます。 利用可能なすべての入門オファーは、App Store によって確認されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتجدد سنويا حتى تقوم بالإلغاء. يتم تأكيد أي عرض تمهيدي متاح من قبل متجر التطبيقات."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "취소하실 때까지 매년 갱신됩니다. 가능한 모든 소개 제안은 App Store에서 확인됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每年续订，直到您取消为止。 任何可用的介绍性优惠都由App Store确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每年續訂，直到您取消為止。 任何可用的介紹性優惠都由App Store確認。"
          }
        }
      }
    },
    "Reports are stored encrypted for up to 30 days. A report does not automatically block anyone or guarantee a response.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los informes se guardan cifrados hasta 30 días. Un informe no bloquea automáticamente a nadie ni garantiza una respuesta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berichte werden bis zu 30 Tage lang verschlüsselt gespeichert. Ein Bericht blockiert niemanden automatisch und garantiert keine Antwort."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "レポートは最大30日間暗号化されて保存されます。 レポートは自動的に誰もブロックしたり、回答を保証したりすることはありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتم تخزين التقارير مشفرة لمدة تصل إلى 30 يوما. لا يقوم التقرير تلقائيا بحظر أي شخص أو ضمان الرد."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보고서는 최대 30일 동안 암호화된 상태로 저장됩니다. 보고서는 자동으로 누구도 차단하거나 응답을 보장하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "报告经过加密存储长达30天。 报告不会自动屏蔽任何人或保证回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "報告經過加密存儲長達30天。 報告不會自動屏蔽任何人或保證回復。"
          }
        }
      }
    },
    "Restore backup": {
      "localizations": {
        "es": {
