    "The backup couldn’t be opened or restored. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup couldn’t be opened or restored. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo abrir ni restaurar la copia de seguridad. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible d’ouvrir ou de restaurer la sauvegarde. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
