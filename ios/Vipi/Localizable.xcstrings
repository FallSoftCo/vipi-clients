          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سجّل دخولك إلى Vipi مجددًا، ثم اربط حساب Fallsoft. ستبقى محادثاتك وملفك الشخصي وفترة التجربة الأصلية كما هي."
          }
        },
        "sw": {
          "stringUnit": {
