    "Use a long, unique passphrase of at least 12 characters. Keep it somewhere safe. Vipi cannot recover this password.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa una contraseña larga y única de al menos 12 caracteres. Guárdala en un lugar seguro. Vipi no puede recuperar esta contraseña."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwenden Sie eine lange, eindeutige Passphrase mit mindestens 12 Zeichen. Bewahren Sie es an einem sicheren Ort auf. Vipi kann dieses Passwort nicht wiederherstellen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "少なくとも12文字の長くてユニークなパスフレーズを使用してください。 安全な場所に保管してください。 Vipiはこのパスワードを復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "최소 12자 이상의 길고 고유한 암호문을 사용하십시오. 안전한 곳에 보관하십시오. Vipi는 이 비밀번호를 복구할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用至少12个字符的长而独特的密码短语。 把它放在安全的地方。 Vipi无法恢复此密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用至少12個字符的長而獨特的密碼短語。 把它放在安全的地方。 Vipi無法恢復此密碼。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez une phrase secrète longue et unique d’au moins 12 caractères. Conservez-la en lieu sûr. Vipi ne peut pas récupérer ce mot de passe."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tumia kaulisiri ndefu ya angalau vibambo 12 ambayo huitumii kwingine. Ihifadhi mahali salama. Vipi haiwezi kurejesha nenosiri hili."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدم عبارة مرور طويلة وفريدة من نوعها لا تقل عن 12 حرفا. احتفظ بها في مكان آمن. لا يمكن ل Vipi استرداد كلمة المرور هذه."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa una frase segreta lunga e unica di almeno 12 caratteri. Conservala in un luogo sicuro. Vipi non può recuperare questa password."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use uma frase secreta longa e exclusiva com pelo menos 12 caracteres. Guarde-a em local seguro. O Vipi não pode recuperar essa senha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use uma frase secreta longa e exclusiva com pelo menos 12 caracteres. Guarde-a em local seguro. O Vipi não pode recuperar essa palavra-passe."
          }
        }
      }
    },
