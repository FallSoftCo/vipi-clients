    "Enter their exact Vipi username. Your phone contacts stay private.": {
      "localizations": {
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Weka jina lake la mtumiaji la Vipi kama lilivyo. Orodha ya anwani kwenye simu yako inabaki binafsi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introduce su nombre de usuario exacto de Vipi. Los contactos de tu teléfono siguen siendo privados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Geben Sie ihren genauen Vipi-Benutzernamen ein. Ihre Telefonkontakte bleiben privat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正確なVipiユーザー名を入力してください。 お使いの電話連絡先はプライバシーが保護されています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أدخل اسم مستخدم Vipi الخاص بهم بالضبط. تظل جهات اتصال هاتفك خاصة."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그들의 정확한 Vipi 사용자 이름을 입력하십시오. 귀하의 전화 연락처는 비공개로 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "输入他们确切的Vipi用户名。 您的手机联系人保持私密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輸入他們確切的Vipi用戶名。 您的手機聯繫人保持私密。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisissez son nom d’utilisateur Vipi exact. Les contacts de votre téléphone restent privés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inserisci il suo nome utente Vipi esatto. I contatti del telefono restano privati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digite o nome de usuário Vipi exato da pessoa. Os contatos do seu telefone permanecem privados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Digite o nome de utilizador Vipi exato da pessoa. Os contatos do seu telefone permanecem privados."
          }
        }
      }
    },
