    "Your saved history stays here. Pending messages from the previous device won’t be resent. Friends will see changed encryption keys.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu historial guardado sigue aquí. Los mensajes pendientes del dispositivo anterior no se reenviarán. Tus amigos verán claves de cifrado cambiadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihr gespeicherter Verlauf bleibt hier. Ausstehende Nachrichten vom vorherigen Gerät werden nicht erneut gesendet. Freunde werden geänderte Verschlüsselungsschlüssel sehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "保存された履歴はここに残ります。 前のデバイスからの保留中のメッセージは再送されません。 友達は変更された暗号鍵を見ることができます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يبقى سجلك المحفوظ هنا. لن يتم إعادة إرسال الرسائل المعلقة من الجهاز السابق. سيرى الأصدقاء مفاتيح التشفير المتغيرة."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "저장된 기록은 여기 남아 있습니다. 이전 기기에서 보류 중인 메시지는 다시 전송되지 않습니다. 친구들은 변경된 암호화 키를 보게 될 것입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您保存的历史记录保留在这里。 来自上一台设备的待处理邮件将不会重新发送。 朋友会看到更改后的加密密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您保存的歷史記錄保留在這裡。 來自上一台設備的待處理郵件將不會重新發送。 朋友會看到更改後的加密密鑰。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre historique enregistré reste ici. Les messages en attente de l’ancien appareil ne seront pas renvoyés. Vos amis verront des clés de chiffrement modifiées."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Historia uliyohifadhi inabaki hapa. Ujumbe unaosubiri kutoka kifaa cha awali hautatumwa tena. Marafiki wataona funguo za usimbaji fiche zilizobadilika."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La cronologia salvata resta qui. I messaggi in attesa del dispositivo precedente non verranno reinviati. Gli amici vedranno chiavi di cifratura cambiate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seu histórico salvo continua aqui. Mensagens pendentes do dispositivo anterior não serão reenviadas. Amigos verão chaves de criptografia alteradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seu histórico guardado continua aqui. Mensagens pendentes do dispositivo anterior não serão reenviadas. Amigos verão chaves de cifragem alteradas."
          }
        }
      }
    },
    "Your username is @%@. Share it so your friend can find you after signing in.": {
