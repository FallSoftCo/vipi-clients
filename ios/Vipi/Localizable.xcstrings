          }
        }
      }
    },
    "You can read, back up and restore your saved history even after a subscription ends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puedes leer, guardar y restaurar tu historial guardado incluso después de que termine una suscripción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie können Ihren gespeicherten Verlauf lesen, sichern und wiederherstellen, auch wenn ein Abonnement endet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サブスクリプションが終了した後でも、保存した履歴を読み、バックアップし、復元することができます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكنك قراءة سجلك المحفوظ ونسخه احتياطيا واستعادته حتى بعد انتهاء الاشتراك."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "구독이 종료된 후에도 저장된 기록을 읽고, 백업하고, 복원할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "即使在订阅结束后，您也可以读取、备份和恢复已保存的历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "即使在訂閱結束後，您也可以讀取、備份和恢復已保存的歷史記錄。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous pouvez lire, sauvegarder et restaurer votre historique enregistré même après la fin d’un abonnement."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unaweza kusoma, kuhifadhi nakala rudufu na kurejesha historia uliyohifadhi hata usajili ukiisha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puoi leggere, salvare e ripristinare la cronologia salvata anche dopo la fine di un abbonamento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você pode ler, fazer backup e restaurar seu histórico salvo mesmo depois que uma assinatura terminar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você pode ler, fazer backup e restaurar seu histórico guardado mesmo depois que uma subscrição terminar."
          }
        }
      }
    },
    "You’ll need to download these languages again before translating offline. Your conversations stay on this device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tendrás que volver a descargar estos idiomas antes de traducir sin conexión. Tus conversaciones permanecen en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie müssen diese Sprachen erneut herunterladen, bevor Sie offline übersetzen können. Ihre Gespräche bleiben auf diesem Gerät."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフラインで翻訳する前に、これらの言語を再度ダウンロードする必要があります。 会話はこのデバイスに残ります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ستحتاج إلى تنزيل هذه اللغات مرة أخرى قبل الترجمة في وضع عدم الاتصال. تبقى محادثاتك على هذا الجهاز."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "오프라인으로 번역하기 전에 이 언어들을 다시 다운로드하셔야 합니다. 귀하의 대화는 이 기기에 그대로 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在离线翻译之前，您需要再次下载这些语言。 您的对话将保留在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在離線翻譯之前，您需要再次下載這些語言。 您的對話將保留在此設備上。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous devrez retélécharger ces langues avant de traduire hors ligne. Vos conversations restent sur cet appareil."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utahitaji kupakua lugha hizi tena kabla ya kutafsiri bila intaneti. Mazungumzo yako yanabaki kwenye kifaa hiki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dovrai scaricare di nuovo queste lingue prima di tradurre offline. Le conversazioni restano su questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você precisará baixar esses idiomas novamente antes de traduzir offline. Suas conversas permanecem neste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você precisará transferir esses idiomas novamente antes de traduzir offline. Suas conversas permanecem neste dispositivo."
          }
        }
      }
    },
