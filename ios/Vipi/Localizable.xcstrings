          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "App Storeに接続してサブスクリプションの料金を確認してください。まだ購読は開始されていません。"
          }
        },
        "ko": {
          "stringUnit": {
