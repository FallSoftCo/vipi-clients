    "Tap to hear %1$@. Hold to read in %2$@.": {
      "comment": "Contextual instruction beside actual interactive message. Language names use the current UI locale. Script instruction only when a distinct complete reading exists. Authored copy requires native linguistic and layout review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tap to hear %1$@. Hold to read in %2$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اضغط للاستماع باللغة %1$@. اضغط مطولًا للقراءة باللغة %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippe, um %1$@ zu hören. Halte gedrückt, um auf %2$@ zu lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca para escuchar en %1$@. Mantén pulsado para leer en %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez pour écouter en %1$@. Maintenez le doigt pour lire en %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tocca per ascoltare in %1$@. Tieni premuto per leggere in %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "タップすると%1$@の音声を聞けます。長押しすると%2$@で読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "탭하여 %1$@로 듣고, 길게 눌러 %2$@로 읽으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque para ouvir em %1$@. Mantenha pressionado para ler em %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque para ouvir em %1$@. Mantenha premido para ler em %2$@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gusa ili usikie %1$@. Shikilia ili usome kwa %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻点即可听%1$@，长按可阅读%2$@释义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "輕點即可聽%1$@，長按可閱讀%2$@釋義。"
          }
        }
      }
    },
