    "The preview expired or the keys changed again. Check the current keys before deciding. Nothing was automatically trusted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La vista previa caducó o las claves volvieron a cambiar. Comprueba las claves actuales antes de decidir. No se ha confiado automáticamente en ninguna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’aperçu a expiré ou les clés ont de nouveau changé. Vérifiez les clés actuelles avant de décider. Aucune confiance n’a été accordée automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’anteprima è scaduta o le chiavi sono cambiate di nuovo. Controlla le chiavi attuali prima di decidere. Nessuna è stata considerata attendibile automaticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A prévia expirou ou as chaves mudaram novamente. Verifique as chaves atuais antes de decidir. Nenhuma foi considerada confiável automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A pré-visualização expirou ou as chaves voltaram a mudar. Verifique as chaves atuais antes de decidir. Nenhuma foi considerada fiável automaticamente."
