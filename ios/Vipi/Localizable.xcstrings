    "Deleting your account won’t cancel an App Store subscription. You can cancel it separately to stop future renewals.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eliminar la cuenta no cancelará ninguna suscripción del App Store. Puedes cancelarla por separado para evitar futuras renovaciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Löschen Ihres Kontos wird ein App Store-Abonnement nicht gekündigt. Sie können es separat stornieren, um zukünftige Verlängerungen zu stoppen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウントを削除しても、App Store のサブスクリプションはキャンセルされません。 今後の更新を停止するために、別途キャンセルすることができます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لن يؤدي حذف حسابك إلى إلغاء اشتراك App Store. يمكنك إلغاؤه بشكل منفصل لإيقاف التجديدات المستقبلية."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "계정을 삭제해도 App Store 구독이 취소되지 않습니다. 향후 갱신을 중단하려면 별도로 취소하실 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "删除您的帐户不会取消 App Store 订阅。 您可以单独取消它，以停止未来的续订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "刪除您的帳戶不會取消 App Store 訂閱。 您可以單獨取消它，以停止未來的續訂。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La suppression du compte n’annule pas un abonnement App Store. Vous pouvez l’annuler séparément pour arrêter les renouvellements futurs."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kufuta akaunti yako hakutaghairi usajili wa App Store. Unaweza kuughairi kando ili kuzuia kujisasisha siku zijazo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’eliminazione dell’account non annulla un abbonamento App Store. Puoi annullarlo separatamente per interrompere i rinnovi futuri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Excluir sua conta não cancela uma assinatura da App Store. Você pode cancelá-la separadamente para interromper renovações futuras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eliminar sua conta não cancela uma subscrição da App Store. Você pode cancelá-la separadamente para interromper renovações futuras."
          }
        }
      }
    },
