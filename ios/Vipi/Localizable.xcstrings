    "Sign in again to finish moving your account. The device change you confirmed is saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vuelve a iniciar sesión para terminar de trasladar tu cuenta. Se ha guardado el cambio de dispositivo que confirmaste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Melden Sie sich erneut an, um die Bewegung Ihres Kontos abzuschließen. Die von Ihnen bestätigte Geräteänderung wurde gespeichert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウントの移行を完了するには、再度サインインしてください。 ご確認いただいたデバイスの変更は保存されています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قم بتسجيل الدخول مرة أخرى لإنهاء نقل حسابك. تم حفظ تغيير الجهاز الذي أكدته."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "계정 이동을 완료하려면 다시 로그인하십시오. 확인하신 장치 변경이 저장되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "再次登录以完成移动您的帐户。 您确认的设备更改已保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "再次登錄以完成移動您的帳戶。 您確認的設備更改已保存。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reconnectez-vous pour terminer le transfert de votre compte. Le changement d’appareil confirmé a été enregistré."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingia tena ili kumaliza kuhamisha akaunti yako. Mabadiliko ya kifaa uliyothibitisha yamehifadhiwa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accedi di nuovo per completare il trasferimento dell’account. Il cambio di dispositivo confermato è stato salvato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entre novamente para concluir a transferência da conta. A troca de dispositivo confirmada foi salva."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entre novamente para concluir a transferência da conta. A troca de dispositivo confirmada foi guardada."
          }
        }
      }
    },
