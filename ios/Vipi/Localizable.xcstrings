    "Create an account or sign in to an existing one. Friends find you by username, not your email.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an account or sign in to an existing one. Friends find you by username, not your email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Crea una cuenta o inicia sesión en una existente. Tus amigos te encuentran por tu nombre de usuario, no por tu correo electrónico."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erstellen Sie ein Konto oder melden Sie sich bei einem bestehenden an. Freunde finden Sie nach Benutzername, nicht nach Ihrer E-Mail-Adresse."
          }
        },
        "ja": {
          "stringUnit": {
