        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每年续订，直到您取消为止。 任何可用的介绍性优惠都由App Store确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每年續訂，直到您取消為止。 任何可用的介紹性優惠都由App Store確認。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Renouvellement annuel jusqu’à annulation. L’App Store confirme toute offre de lancement disponible."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usajili unajisasisha kila mwaka hadi uughairi. Ofa yoyote ya kuanza inathibitishwa na App Store."
