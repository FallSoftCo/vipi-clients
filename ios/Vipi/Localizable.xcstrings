        }
      }
    },
    "Say hello. Your messages are end-to-end encrypted.": {
      "localizations": {
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sema habari. Ujumbe wako una usimbaji fiche kutoka mwanzo hadi mwisho."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saluda. Tus mensajes están cifrados de extremo a extremo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fangen Sie eine Unterhaltung an. Ihre Nachrichten sind Ende-zu-Ende verschlüsselt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "こんにちはと言ってください。 お客様のメッセージはエンドツーエンドで暗号化されています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قل مرحبا. رسائلك مشفرة من طرف إلى طرف."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "인사하세요. 귀하의 메시지는 종단 간 암호화됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打个招呼。 您的消息是端到端加密的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打個招呼。 您的消息是端到端加密的。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dites bonjour. Vos messages sont chiffrés de bout en bout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saluta. I tuoi messaggi sono cifrati end-to-end."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diga olá. Suas mensagens têm criptografia de ponta a ponta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diga olá. Suas mensagens têm cifragem de ponta a ponta."
          }
        }
      }
    },
    "Selected words and short phrases switch between your language and the language you choose. Word order and grammar stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected words and short phrases switch between your language and the language you choose. Word order and grammar stay the same."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maneno yaliyochaguliwa na vifungu vifupi hubadilika kati ya lugha yako na lugha unayochagua. Mpangilio wa maneno na sarufi hubaki vilevile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las palabras y frases cortas seleccionadas cambian entre tu idioma y el que elijas. El orden de las palabras y la gramática no cambian."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ausgewählte Wörter und kurze Phrasen wechseln zwischen Ihrer Sprache und der von Ihnen gewählten Sprache. Wortstellung und Grammatik bleiben gleich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選択した単語や短いフレーズは、あなたの言語と選択した言語の間で切り替わります。 語順と文法は変わりません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنتقل الكلمات والعبارات القصيرة المختارة بين لغتك واللغة التي تختارها. يبقى ترتيب الكلمات والقواعد النحوية كما هي."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "선택한 단어와 짧은 구절은 귀하의 언어와 선택한 언어 사이를 전환합니다. 어순과 문법은 동일하게 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选定的单词和短句在您的语言和您选择的语言之间切换。 词序和语法保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選定的單詞和短句在您的語言和您選擇的語言之間切換。 詞序和語法保持不變。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les mots et courtes expressions sélectionnés passent de votre langue à la langue choisie. L’ordre des mots et la grammaire restent identiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le parole e le brevi frasi selezionate cambiano tra la tua lingua e quella scelta. L’ordine delle parole e la grammatica restano invariati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palavras e frases curtas selecionadas alternam entre seu idioma e o idioma escolhido. A ordem das palavras e a gramática permanecem iguais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palavras e frases curtas selecionadas alternam entre seu idioma e o idioma escolhido. A ordem das palavras e a gramática permanecem iguais."
          }
        }
      }
    },
    "Send only the reply shown above and your selected reason to Vipi. Reports are stored encrypted for up to 30 days. Your other messages aren’t included.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envía a Vipi solo la respuesta mostrada arriba y el motivo seleccionado. Los informes se guardan cifrados hasta 30 días. Tus otros mensajes no se incluyen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Senden Sie nur die oben gezeigte Antwort und den von Ihnen ausgewählten Grund an Vipi. Berichte werden bis zu 30 Tage lang verschlüsselt gespeichert. Ihre anderen Nachrichten sind nicht enthalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "上記の返信と選択した理由のみをVipiに送信してください。 レポートは最大30日間暗号化されて保存されます。 他のメッセージは含まれておりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "위에 표시된 답변과 선택한 사유만 Vipi에 보내십시오. 보고서는 최대 30일 동안 암호화된 상태로 저장됩니다. 다른 메시지는 포함되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "仅将上面显示的回复和您选择的理由发送给Vipi。 报告经过加密存储长达30天。 您的其他消息不包括在内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "僅將上面顯示的回復和您選擇的理由發送給Vipi。 報告經過加密存儲長達30天。 您的其他消息不包括在內。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envoyez à Vipi uniquement la réponse affichée ci-dessus et le motif choisi. Les signalements sont conservés chiffrés jusqu’à 30 jours. Vos autres messages ne sont pas inclus."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tuma kwa Vipi jibu linaloonyeshwa hapo juu na sababu uliyochagua pekee. Ripoti huhifadhiwa zikiwa zimesimbwa fiche kwa hadi siku 30. Ujumbe wako mwingine haujumuishwi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أرسل فقط الرد الموضح أعلاه والسبب الذي اخترته إلى Vipi. يتم تخزين التقارير مشفرة لمدة تصل إلى 30 يوما. لا يتم تضمين رسائلك الأخرى."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Invia a Vipi solo la risposta mostrata sopra e il motivo selezionato. Le segnalazioni sono conservate cifrate fino a 30 giorni. Gli altri messaggi non sono inclusi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envie ao Vipi apenas a resposta exibida acima e o motivo escolhido. Denúncias são armazenadas com criptografia por até 30 dias. Suas outras mensagens não são incluídas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Envie ao Vipi apenas a resposta exibida acima e o motivo escolhido. Denúncias são armazenadas com cifragem por até 30 dias. Suas outras mensagens não são incluídas."
          }
        }
      }
    },
