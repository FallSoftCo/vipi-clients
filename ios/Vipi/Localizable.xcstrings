        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Backup konnte nicht geöffnet oder wiederhergestellt werden. Bitte versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "バックアップを開くか復元することができませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
