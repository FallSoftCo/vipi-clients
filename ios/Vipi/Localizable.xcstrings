    "Subscriptions are managed separately. Friends’ copies and backups saved elsewhere remain.": {
      "localizations": {
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usajili wa kulipia unasimamiwa kando. Nakala za marafiki na nakala rudufu zilizohifadhiwa kwingine zinabaki."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las suscripciones se gestionan por separado. Las copias de tus amigos y las copias de seguridad guardadas en otros lugares permanecen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abos werden getrennt verwaltet. Kopien Ihrer Freunde und anderswo gespeicherte Backups bleiben erhalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サブスクリプションは個別に管理されます。 友人のコピーやバックアップは、他の場所に保存されたままです。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتم إدارة الاشتراكات بشكل منفصل. تبقى نسخ الأصدقاء والنسخ الاحتياطية المحفوظة في مكان آخر."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "구독은 별도로 관리됩니다. 친구가 가진 사본과 다른 곳에 저장된 백업은 그대로 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "订阅是单独管理的。 朋友的副本和保存在其他地方的备份仍然存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "訂閱是單獨管理的。 朋友的副本和保存在其他地方的備份仍然存在。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les abonnements sont gérés séparément. Les copies de vos amis et les sauvegardes enregistrées ailleurs restent disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli abbonamenti sono gestiti separatamente. Le copie degli amici e i backup salvati altrove rimangono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As assinaturas são gerenciadas separadamente. Cópias de amigos e backups salvos em outros lugares permanecem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As subscrições são geridas separadamente. Cópias de amigos e backups guardados em outros lugares permanecem."
          }
        }
      }
    },
    "Subscriptions aren’t available yet. You haven’t been enrolled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions aren’t available yet. You haven’t been enrolled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las suscripciones aún no están disponibles. No te has suscrito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abonnements sind noch nicht verfügbar. Sie wurden nicht eingeschrieben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サブスクリプションはまだご利用いただけません。 ご登録いただいておりません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الاشتراكات غير متوفرة بعد. لم يتم تسجيلك."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "구독은 아직 이용할 수 없습니다. 등록되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "订阅还不可用。 你还没有注册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "訂閱還不可用。 你還沒有註冊。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les abonnements ne sont pas encore disponibles. Vous n’avez souscrit à rien."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usajili bado haupatikani. Hujasajiliwa kulipia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli abbonamenti non sono ancora disponibili. Non hai sottoscritto alcun abbonamento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As assinaturas ainda não estão disponíveis. Você não foi inscrito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As subscrições ainda não estão disponíveis. Você não foi inscrito."
          }
        }
      }
    },
