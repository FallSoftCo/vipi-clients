    "Messages between you will stop. Your chat stays on this device. You can unblock anytime.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages between you will stop. Your chat stays on this device. You can unblock anytime."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ujumbe kati yenu utasitishwa. Mazungumzo yanabaki kwenye kifaa hiki. Unaweza kuondoa kizuizi wakati wowote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los mensajes entre vosotros se detendrán. El chat permanece en este dispositivo. Puedes desbloquearlo cuando quieras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Nachrichten zwischen Ihnen werden aufhören. Ihr Chat bleibt auf diesem Gerät. Sie können jederzeit entsperren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この相手とのメッセージは停止します。チャットはこのデバイスに残ります。いつでもブロックを解除できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ستتوقف الرسائل بينكما. تبقى الدردشة الخاصة بك على هذا الجهاز. يمكنك إلغاء الحظر في أي وقت."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "상대방과 주고받는 메시지가 중단됩니다. 채팅은 이 기기에 남습니다. 언제든 차단을 해제할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你们之间的信息将停止。 您的聊天记录会保留在此设备上。 你可以随时解除封锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你們之間的信息將停止。 您的聊天記錄會保留在此設備上。 你可以隨時解除封鎖。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les messages entre vous seront arrêtés. Votre discussion reste sur cet appareil. Vous pouvez débloquer cette personne à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I messaggi tra voi verranno interrotti. La chat resta su questo dispositivo. Puoi sbloccare la persona in qualsiasi momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As mensagens entre vocês serão interrompidas. Sua conversa permanece neste dispositivo. Você pode desbloquear a pessoa a qualquer momento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As mensagens entre vocês serão interrompidas. Sua conversa permanece neste dispositivo. Você pode desbloquear a pessoa a qualquer momento."
          }
        }
      }
    },
