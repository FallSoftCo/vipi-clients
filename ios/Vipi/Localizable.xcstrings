    "Subscriptions are managed separately. Friends’ copies and backups saved elsewhere remain.": {
      "localizations": {
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usajili wa kulipia unasimamiwa kando. Nakala za marafiki na nakala rudufu zilizohifadhiwa kwingine zinabaki."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las suscripciones se gestionan por separado. Las copias de tus amigos y las copias de seguridad guardadas en otros lugares permanecen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abonnements werden separat verwaltet. Kopien und Backups von Freunden, die an anderer Stelle gespeichert wurden, bleiben bestehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "サブスクリプションは個別に管理されます。 友人のコピーやバックアップは、他の場所に保存されたままです。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتم إدارة الاشتراكات بشكل منفصل. تبقى نسخ الأصدقاء والنسخ الاحتياطية المحفوظة في مكان آخر."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "구독은 별도로 관리됩니다. 친구들의 복사본과 백업은 다른 곳에 저장되어 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "订阅是单独管理的。 朋友的副本和保存在其他地方的备份仍然存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "訂閱是單獨管理的。 朋友的副本和保存在其他地方的備份仍然存在。"
          }
        }
      }
    },
