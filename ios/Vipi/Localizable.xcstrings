    "Tap to listen. Hold to see meanings. Double-tap to change script.": {
      "comment": "Full-message chat translation gesture/status; practice means the language the person is learning.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to listen. Hold to see meanings. Double-tap to change script."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para escuchar. Mantén pulsado para ver el significado. Toca dos veces para cambiar la escritura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour écouter. Maintenez pour voir le sens. Touchez deux fois pour changer d’écriture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen zum Anhören. Gedrückt halten für die Bedeutung. Doppeltippen zum Wechseln der Schrift."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per ascoltare. Tieni premuto per vedere il significato. Tocca due volte per cambiare scrittura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para ouvir. Mantenha pressionado para ver o significado. Toque duas vezes para mudar a escrita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para ouvir. Mantenha premido para ver o significado. Toque duas vezes para mudar a escrita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップで読み上げ。長押しで意味を表示。ダブルタップで文字表記を切り替え。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭해서 들어 보세요. 길게 누르면 뜻이 보여요. 두 번 탭하면 문자 표기가 바뀌어요."
          }
        },
        "zh-Hans": {
