    "Download %@ and %@ for full-message translation offline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download %@ and %@ for full-message translation offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Descarga %@ y %@ para traducir mensajes completos sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Téléchargez %@ et %@ pour traduire les messages complets hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scarica %@ e %@ per tradurre i messaggi completi offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Baixe %@ e %@ para traduzir mensagens completas offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Laden Sie %1$@ und %2$@ für die Übersetzung von vollständigen Nachrichten offline herunter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフラインでフルメッセージ翻訳を行うために、%1$@ と %2$@ をダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ 및 %2$@를 다운로드하여 전체 메시지 번역을 오프라인으로 사용하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "下载%1$@和%2$@以进行离线完整消息翻译。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "下載%1$@和%2$@以進行離線完整消息翻譯。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قم بتنزيل %1$@ و%2$@ لترجمة الرسالة الكاملة في وضع عدم الاتصال."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transfira %@ e %@ para traduzir mensagens completas sem ligação."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pakua %@ na %@ ili kutafsiri ujumbe mzima bila intaneti."
          }
        }
      }
    },
