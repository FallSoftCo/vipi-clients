          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inicia o restaura tu plan de Vipi en Ajustes → Suscripciones para enviar mensajes. Tus chats y borradores guardados siguen disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Starten oder stellen Sie Ihren Vipi-Plan unter Einstellungen → Abonnements wieder her, um Nachrichten zu senden. Ihre gespeicherten Chats und Entwürfe bleiben verfügbar."
          }
        },
        "ja": {
          "stringUnit": {
