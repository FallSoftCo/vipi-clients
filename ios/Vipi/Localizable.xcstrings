          }
        }
      }
    },
    "Reports are stored encrypted for up to 30 days. A report does not automatically block anyone or guarantee a response.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los informes se guardan cifrados hasta 30 días. Un informe no bloquea automáticamente a nadie ni garantiza una respuesta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berichte werden bis zu 30 Tage lang verschlüsselt gespeichert. Ein Bericht blockiert niemanden automatisch und garantiert keine Antwort."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "レポートは最大30日間暗号化されて保存されます。 レポートは自動的に誰もブロックしたり、回答を保証したりすることはありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتم تخزين التقارير مشفرة لمدة تصل إلى 30 يوما. لا يقوم التقرير تلقائيا بحظر أي شخص أو ضمان الرد."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "보고서는 최대 30일 동안 암호화된 상태로 저장됩니다. 보고서는 자동으로 누구도 차단하거나 응답을 보장하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "报告经过加密存储长达30天。 报告不会自动屏蔽任何人或保证回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "報告經過加密存儲長達30天。 報告不會自動屏蔽任何人或保證回復。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les signalements sont conservés chiffrés jusqu’à 30 jours. Un signalement ne bloque personne automatiquement et ne garantit pas de réponse."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ripoti huhifadhiwa zikiwa zimesimbwa fiche kwa hadi siku 30. Kuripoti hakumzuii mtu kiotomatiki wala hakuhakikishi kupata jibu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le segnalazioni sono conservate cifrate fino a 30 giorni. Una segnalazione non blocca automaticamente nessuno e non garantisce una risposta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denúncias são armazenadas com criptografia por até 30 dias. Uma denúncia não bloqueia ninguém automaticamente nem garante resposta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denúncias são armazenadas com cifragem por até 30 dias. Uma denúncia não bloqueia ninguém automaticamente nem garante resposta."
          }
        }
      }
    },
