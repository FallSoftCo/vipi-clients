    "Future messages will use the displayed new keys. They remain unverified until you compare the security number with your friend.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los mensajes futuros usarán las nuevas claves mostradas. Seguirán sin verificar hasta que compares el número de seguridad con tu amigo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zukünftige Nachrichten werden die angezeigten neuen Schlüssel verwenden. Sie bleiben unverifiziert, bis Sie die Sicherheitsnummer mit der Ihres Freundes vergleichen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "今後のメッセージでは、表示された新しいキーを使用します。 セキュリティ番号を友人と比較するまで、未確認のままです。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ستستخدم الرسائل المستقبلية المفاتيح الجديدة المعروضة. تظل غير متحققة حتى تقارن رقم الأمان مع صديقك."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "향후 메시지는 표시된 새 키를 사용할 것입니다. 보안 번호를 친구와 비교할 때까지 그들은 확인되지 않은 상태로 남아 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未来的消息将使用显示的新键。 在您与朋友比较安全号码之前，它们仍未得到验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未來的消息將使用顯示的新鍵。 在您與朋友比較安全號碼之前，它們仍未得到驗證。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les futurs messages utiliseront les nouvelles clés affichées. Elles resteront non vérifiées tant que vous n’aurez pas comparé le numéro de sécurité avec votre ami."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ujumbe ujao utatumia funguo mpya zinazoonyeshwa. Hazitathibitishwa hadi ulinganishe nambari ya usalama na rafiki yako."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I messaggi futuri useranno le nuove chiavi mostrate. Rimarranno non verificate finché non confronterai il numero di sicurezza con il tuo amico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mensagens futuras usarão as novas chaves exibidas. Elas continuarão não verificadas até você comparar o número de segurança com seu amigo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mensagens futuras usarão as novas chaves exibidas. Elas continuarão não verificadas até você comparar o número de segurança com seu amigo."
          }
        }
      }
    },
