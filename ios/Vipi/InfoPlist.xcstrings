{
  "sourceLanguage": "en",
  "strings": {
    "NSContactsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a phone contact to invite. Names, numbers and email addresses stay on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un contacto para invitarle. Los nombres, números y correos se quedan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un contact à inviter. Les noms, numéros et adresses e-mail restent sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Kontakt für die Einladung. Namen, Nummern und E-Mail-Adressen bleiben auf diesem Gerät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un contatto da invitare. Nomi, numeri e indirizzi email restano su questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um contato para convidar. Nomes, números e endereços de e-mail ficam neste dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um contacto para convidar. Nomes, números e endereços de e-mail ficam neste dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待する連絡先を選びます。名前、番号、メールアドレスはこの端末内にとどまります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대할 연락처를 선택하세요. 이름, 번호, 이메일 주소는 이 기기에만 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要邀请的联系人。姓名、号码和电子邮件地址只保留在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要邀請的聯絡人。姓名、號碼和電子郵件地址只保留在此裝置上。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر جهة اتصال لدعوتها. تبقى الأسماء والأرقام وعناوين البريد الإلكتروني على هذا الجهاز."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua anwani ya mtu wa kumwalika. Majina, namba na anwani za barua pepe hubaki kwenye kifaa hiki."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo or video to share with a friend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una foto o graba un vídeo para compartirlo con un amigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une photo ou une vidéo à partager avec un ami."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm ein Foto oder Video auf, um es mit einer befreundeten Person zu teilen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta una foto o registra un video da condividere con un amico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire uma foto ou grave um vídeo para compartilhar com um amigo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達に送る写真やビデオを撮影します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구에게 보낼 사진이나 동영상을 촬영해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄照片或视频与好友分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍攝照片或影片並與好友分享。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط صورة أو فيديو لمشاركته مع صديق."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Piga picha au rekodi video ya kushiriki na rafiki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire uma fotografia ou grave um vídeo para partilhar com um amigo."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record audio for a voice message or video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba audio para un mensaje de voz o un vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez du son pour un message vocal ou une vidéo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm Ton für eine Sprachnachricht oder ein Video auf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra l’audio per un messaggio vocale o un video."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave áudio para uma mensagem de voz ou um vídeo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声メッセージやビデオの音声を録音します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 메시지나 동영상에 쓸 소리를 녹음해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为语音消息或视频录制声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為語音訊息或影片錄製聲音。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الصوت لرسالة صوتية أو فيديو."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekodi sauti kwa ujumbe wa sauti au video."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave áudio para uma mensagem de voz ou vídeo."
          }
        }
      }
    }
  },
  "version": "1.0"
}
